static func get_entry(id: String) -> Dictionary:
	return ENTRIES.get(id, {}).duplicate(true)

static func tier_of(id: String) -> int:
	# game.html 9414~9423: urgent tier5 is assigned by dispatcher, not this classifier.
	if id == "enh_hint":
		return 1
	if id.begins_with("bl_") or id.begins_with("cd_") or id.begins_with("combo_") or id == "multi_kill" or id == "low_hp_kill" or id == "stage_clear" or id.begins_with("chapter_clear_") or id.begins_with("trophy_") or id.begins_with("enh_") or id == "first_legend" or id.begins_with("speed_") or id == "elite_kill" or id == "miniboss_kill" or id.begins_with("build_") or id.begins_with("diff_") or id.begins_with("syn_"):
		return 2
	if id == "boss_elem":
		return 3
	if id.begins_with("boss_") or id == "near_boss" or id == "elite_first" or id == "miniboss_appear":
		return 4
	if id.begins_with("melee_") or id.begins_with("resource_") or id == "enemy_ice" or id == "rage_full2" or id == "mp_warn" or id == "low_st":
		return 3
	if id.begins_with("tut_") or id.begins_with("parry_") or id.begins_with("sp_") or id.begins_with("has_") or id == "bag_full" or id == "low_mats" or id == "shift_hint":
		return 1
	if id.begins_with("idle_") or id.begins_with("env_") or id.begins_with("chapter_") or id.begins_with("petTalk"):
		return 0
	return 2

var assertions: int=0
var failures: int=0
var scenario: String="isolation"
var source_path: String=ProjectSettings.globalize_path(preload("res://source_snapshot/snapshot.gd").PATH)
var source_events: int=0
var source_draws: int=0
var source_contacts: int=0

func _initialize() -> void:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--source-game="): source_path = ProjectSettings.globalize_path(preload("res://source_snapshot/snapshot.gd").PATH)
	call_deferred("_run")

func _run() -> void:
	var isolated: bool=ProjectSettings.get_setting("application/config/use_custom_user_dir",false)==true \
		and ProjectSettings.get_setting("application/config/custom_user_dir_name","")==USERDIR \
		and OS.get_user_data_dir().get_file()==USERDIR
	check(isolated,"exact settings and actual OS userdir")
	if not isolated:
		finish(2)
		return
	check(not source_path.is_empty() and FileAccess.get_sha256(source_path)==GAME_SHA256,"latest main game hash")
	for raw: String in ORACLE_ROWS:
		var row: Dictionary=JSON.parse_string(raw)
		scenario=row["name"]+":"+row["enemy"]["s"]+":t"+str(row["enemy"]["st2"])
		var result: Dictionary=consume(row)
		check(result["status"]=="READY" and result.get("done",false),"bounded stream READY/done: "+str(result.get("reason")))
		if result["status"]!="READY": continue
		check(equivalent(result["enemy"],row["expected"]["enemy"]),"all source actor fields")
		check(equivalent(result["player"],row["expected"]["player"]),"owner readback player preserved")
		check(equivalent(result["all_events"],row["expected"]["events"]),"owned writes/globals/commands/RNG exact order + source sites")
		check(equivalent(result["globals"],row["expected"]["globals"]),"only authored global writes")
		check(result["cursor"]==row["expected"]["cursor"],"shared RNG cursor includes nested owner fixture draws")
		check(result["contacts"]==row["responses"].size(),"geometric request count, not actual hits")
		source_events+=result["all_events"].size()
		source_contacts+=result["contacts"]
		for event: Dictionary in result["all_events"]:
			if event["kind"]=="rng": source_draws+=1
	_test_anchors()
	_test_provider_failures()
	_test_upstream_and_scope()
	finish(0 if failures==0 else 1)

func consume(row: Dictionary) -> Dictionary:
	var before: Dictionary=row["enemy"].duplicate(true)
	var player_before: Dictionary=row["player"].duplicate(true)
	var started: Dictionary=Melee.begin_tick(int(row["si"]),row["enemy"],row["sp"],row["player"],row["options"])
	check(started["status"]=="READY","begin valid source snapshot")
	if started["status"]!="READY": return started
	var token: Dictionary=started["continuation"]
	var response: Variant=null
	var events: Array=[]
	var cursor: Array=[0]
	var contacts: int=0
	var globals: Dictionary={"shake":71,"hitStop":99}
	var result: Dictionary={}
	for guard in range(80):
		var token_before: Dictionary=token.duplicate(true)
		result=Melee.next_tick(token,response,func(_tag: String) -> Variant:
			var u: Variant=row["units"][cursor[0]%row["units"].size()]
			cursor[0]+=1
			return u)
		check(equivalent(token,token_before),"continuation input read-only")
		if result["status"]!="READY": return result
		check(result["full_tick_complete"]==false,"not a complete updateE or actual damage proof")
		events.append_array(result["events"])
		for event: Dictionary in result["events"]:
			if event["kind"]=="global_write": globals[event["field"]]=event["value"]
		if result["done"]: break
		var command: Dictionary=result["command"]
		check(command["executed"]==false,"requests remain unexecuted")
		response={"ack":true}
		if command["command"]=="canMv": response["value"]=row["collision"]
		elif command["command"]=="resolve_boss_melee_contact":
			check(contacts<row["responses"].size(),"original protected owner readback exists")
			if contacts>=row["responses"].size(): return {"status":"NOT_READY","reason":"fixture_contact_missing"}
			var authority: Dictionary=row["responses"][contacts]
			response["enemy_after"]=authority["enemy_after"]
			response["player_after"]=authority["player_after"]
			cursor[0]=int(authority["cursor_after"])
			contacts+=1
		else: cursor[0]+=int(row["nested"])
		token=result["continuation"]
	check(equivalent(row["enemy"],before) and equivalent(row["player"],player_before),"actor/player inputs read-only")
	result["all_events"]=events
	result["globals"]=globals
	result["cursor"]=cursor[0]
	result["contacts"]=contacts
	return result

func equivalent(a: Variant,b: Variant) -> bool:
	if a is Dictionary and b is Dictionary:
		if a.size()!=b.size(): return false
		for key in b:
			if not a.has(key) or not equivalent(a[key],b[key]): return false
		return true
	if a is Array and b is Array:
		if a.size()!=b.size(): return false
		for i in range(b.size()):
			if not equivalent(a[i],b[i]): return false
		return true
	if (a is int or a is float) and (b is int or b is float):
		if b==floor(float(b)): return a==b
		return abs(float(a)-float(b))<=1e-12*maxf(1.0,abs(float(b)))
	return typeof(a)==typeof(b) and a==b

func actor(state: String="bossSlash") -> Dictionary:
	return {"s":state,"ib":true,"etype":0,"x":0,"y":0,"r":44,"facing":0,"st2":5,"atk":46,"el":0,
		"_bossPhase":0,"_slashIdx":0,"_slashCnt":3,"_sweepDir":1,"poise":321,"reviveIframes":0}
func player(distance: float=100,iframes: float=0) -> Dictionary:
	return {"x":distance,"y":0,"r":12,"iframes":iframes,"s":"idle","kb":{"x":2,"y":3}}
func fixture(e: Dictionary,p: Dictionary) -> Dictionary:
	return consume({"si":0,"enemy":e,"player":p,"sp":1,"options":{"shake":100,"hit_stop":100},"units":[0.5],"nested":0,"collision":false,"responses":[]})

func _test_anchors() -> void:
	scenario="independent-acceptance"
	for phase in [0,4]:
		var e: Dictionary=actor()
		e["_slashCnt"]=3+int(phase*1.5)
		var count: int=0
		while e["s"]=="bossSlash" and count<10:
			e["st2"]=0
			var result: Dictionary=fixture(e,player(1500))
			check(result["status"]=="READY","authored slash end valid")
			e=result["enemy"]
			count+=1
		check(count==(3 if phase==0 else 9) and e["s"]=="recover" and e["st2"]==25,"phase0=3 /phase4=9 authored slash chain, no fake live attacks")
	for phase in [0,4]:
		var e: Dictionary=actor("bossSlam")
		e["_bossPhase"]=phase
		e["st2"]=0
		var result: Dictionary=fixture(e,player(2000))
		check(result["enemy"]["shockR"]==0 and result["enemy"]["shockMax"]==(1000 if phase==0 else 1320),"slam si0 R1000 /1320")
		check(result["enemy"]["s"]=="recover" and result["enemy"]["st2"]==40,"radius write does not enter bossShock state")
	for state in ["bossSlash","bossSweep"]:
		var e: Dictionary=actor(state)
		e["st2"]=5 if state=="bossSlash" else 7
		var result: Dictionary=fixture(e,player(100,1))
		check(result["contacts"]==0,"positive player iframe suppresses additional hit request")
		e["st2"]=10 if state=="bossSlash" else 14
		result=fixture(e,player(100))
		check(result["contacts"]==0,"outside authored progress window no hit")
	var e: Dictionary=actor("bossSweep")
	e["st2"]=7
	var started: Dictionary=Melee.begin_tick(0,e,1,player(),{})
	var pending: Dictionary=Melee.next_tick(started["continuation"])
	check(pending["command"]["command"]=="resolve_boss_melee_contact","inside window creates protected request")
	check(pending["command"]["args"][0]["hurtP_formula"]["multiplier"]==1.8 and pending["command"]["args"][0]["combat_verified"]==false,"raw formula metadata is not damage success")
	check(not pending["enemy"].has("_hitLatch") and not pending["enemy"].has("_meleeHit"),"no added hit latch")

func _test_provider_failures() -> void:
	scenario="missing-authorities"
	var e: Dictionary=actor("bossSweep")
	e["st2"]=7
	var begin: Dictionary=Melee.begin_tick(0,e,1,player())
	var pending: Dictionary=Melee.next_tick(begin["continuation"])
	for response in [null,{"ack":true},{"ack":true,"enemy_after":e},{"ack":true,"enemy_after":{},"player_after":{}}]:
		var failed: Dictionary=Melee.next_tick(pending["continuation"],response)
		check(failed["status"]=="NOT_READY" and failed["enemy"]==null,"no invented protected contact success/readback")
	for si in [-1,4,34]: check(Melee.begin_tick(si,e,1,player())["status"]=="NOT_READY","unowned stage")
	check(Melee.begin_tick(0,actor("bossCharge"),1,player())["status"]=="NOT_READY","no unrelated state adoption")
	check(Melee.begin_tick(0,e,INF,player())["status"]=="NOT_READY","finite clock required")
	check(Melee.begin_tick(0,e,1,{})["status"]=="NOT_READY","no dummy player")
	check(Melee.next_tick({})["status"]=="NOT_READY","no forged empty continuation")
	e=actor("bossSlashWind")
	begin=Melee.begin_tick(0,e,1,player())
	check(Melee.next_tick(begin["continuation"])["status"]=="NOT_READY","wind RNG provider required")
	for unit in [-1,1,NAN,INF,true,null,"0.5"]:
		var calls: Array=[]
		var failed: Dictionary=Melee.next_tick(begin["continuation"],null,func(tag: String) -> Variant:
			calls.append(tag)
			return unit)
		check(failed["status"]=="NOT_READY" and failed["enemy"]==null,"invalid unit no state")
		check(calls.size()==1 and failed["rng_ledger"].size()==1,"invalid draw attempt retained")
	e=actor("bossSlash")
	begin=Melee.begin_tick(0,e,1,player())
	pending=Melee.next_tick(begin["continuation"])
	check(Melee.next_tick(pending["continuation"],{"ack":true})["status"]=="NOT_READY","movement needs actual collision bool")

func _test_upstream_and_scope() -> void:
	scenario="BC02-05-06-contracts"
	var actions: Array[StringName]=InputMap.get_actions()
	var children: int=root.get_child_count()
	var fps: int=Engine.max_fps
	var locale: String=TranslationServer.get_locale()
	var spawn: Dictionary=Spawn.build_spawn_packet({"si":0,"room":0,"player_level":1,"stage_diff_offset":0,"difficulty_index":0,"x":0,"y":0},func(_tag: String) -> float: return 0.5,func(_x: float,_y: float,_r: float) -> bool: return true)
	check(spawn["status"]=="READY","actual BC02 packet")
	if spawn["status"]!="READY": return
	var start: Dictionary=Start.begin_start(0,"slashCombo",spawn["fields"],100,0,0,{})
	var token: Dictionary=start["continuation"]
	var response: Variant=null
	var e: Dictionary={}
	for guard in range(5):
		var next: Dictionary=Start.next_start(token,response)
		check(next["status"]=="READY","BC06 slash start packet")
		if next["status"]!="READY": return
		e=next["enemy"]
		if next["done"]: break
		token=next["continuation"]
		response={"ack":true}
	check(e["_slashCnt"]==3 and e["s"]=="bossSlashWind","BC06 source count/state")
	var clock: Dictionary=Phase.clock_step(0,"after_projectile_charge",e,1,{"flow_direction":null,"player_x":100,"player_y":0})
	var started: Dictionary=Melee.begin_tick(0,clock["enemy"],1,player())
	check(started["status"]=="READY","BC05-decremented clock accepted")
	var final: Dictionary=Melee.next_tick(started["continuation"],null,func(_tag: String) -> float: return 0.5)
	check(final["status"]=="READY" and final["done"] and final["enemy"]["st2"]==clock["enemy"]["st2"],"no duplicate st2 decrement")
	check(final["enemy"]["poise"]==e["poise"] and final["enemy"]["reviveIframes"]==e["reviveIframes"],"protected actor fields unchanged without contact owner")
	check(Melee.source_receipt()["live_combat_connected"]==false and Melee.source_receipt()["damage_or_parry_execution_verified"]==false,"no fake combat/QE pass")
	check(InputMap.get_actions()==actions and root.get_child_count()==children,"no input/actor mutation")
	check(Engine.max_fps==fps and TranslationServer.get_locale()==locale,"no global setting mutation")

func check(ok: bool,message: String) -> void:
	assertions+=1
	if not ok:
		failures+=1
		printerr("BC07_FAIL ",scenario," ",message)
func finish(code: int) -> void:
	print("BC07_RESULT ",JSON.stringify({"assertions":assertions,"failures":failures,"skipped":[],"source_cases":ORACLE_ROWS.size(),"source_events":source_events,"source_rng_draws":source_draws,"protected_contact_requests":source_contacts,"damage_or_parry_evidence":false,"userdir":OS.get_user_data_dir()}))
	quit(code)

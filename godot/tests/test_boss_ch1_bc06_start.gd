var assertions: int = 0
var failures: int = 0
var scenario: String = "isolation"
var source_path: String = ""
var source_events: int = 0
var source_draws: int = 0

func _initialize() -> void:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--source-game="): source_path = arg.trim_prefix("--source-game=")
	call_deferred("_run")

func _run() -> void:
	var isolated: bool = ProjectSettings.get_setting("application/config/use_custom_user_dir",false)==true \
		and ProjectSettings.get_setting("application/config/custom_user_dir_name","")==USERDIR \
		and OS.get_user_data_dir().get_file()==USERDIR
	check(isolated,"exact settings and actual OS userdir")
	if not isolated:
		finish(2)
		return
	check(not source_path.is_empty() and FileAccess.get_sha256(source_path)==GAME_SHA256,"latest main source hash")
	check(Start.source_receipt()["parryable_ids"]==PARRY_SOURCE,"protected source Set read-only exact copy")
	for raw: String in ORACLE_ROWS:
		var row: Dictionary = JSON.parse_string(raw)
		scenario = row["name"]+":"+str(row["si"])+":"+row["id"]+":phase"+str(row["phase"])
		var result: Dictionary = consume(int(row["si"]),row["id"],row["enemy"],row["d"],int(row["phase"]),row["extra"],row["context"],row["units"],row["collision"],row["safe"],row["initial_queues"],int(row["nested"]))
		check(result["status"]=="READY" and result.get("done",false),"bounded stream READY/done: "+str(result.get("reason")))
		if result["status"]!="READY": continue
		check(equivalent(result["enemy"],row["expected"]["enemy"]),"all source actor keys/values")
		check(equivalent(result["all_events"],row["expected"]["events"]),"source write/RNG/command order + values + lines")
		check(equivalent(result["queues"],row["expected"]["queues"]),"source global queues preserve existing entries and boss reference")
		check(result["cursor"]==row["expected"]["cursor"],"actual RNG cursor including nested helper fixture draws")
		source_events += result["all_events"].size()
		for event: Dictionary in result["all_events"]:
			if event["kind"]=="rng": source_draws+=1
	_test_anchors()
	_test_missing_providers()
	_test_upstream_and_scope()
	finish(0 if failures==0 else 1)

func consume(si: int, id: String, enemy: Dictionary, d: float, phase: int, extra: float,
		context: Dictionary, units: Array, collision: bool=true, safe: Variant=null,
		initial_queues: Dictionary={}, nested: int=0) -> Dictionary:
	var before: Dictionary = enemy.duplicate(true)
	var context_before: Dictionary = context.duplicate(true)
	var result: Dictionary = Start.begin_start(si,id,enemy,d,phase,extra,context)
	check(equivalent(enemy,before) and equivalent(context,context_before),"begin inputs read-only")
	if result["status"]!="READY": return result
	var token: Dictionary = result["continuation"]
	var response: Variant = null
	var events: Array = []
	var queues: Dictionary = initial_queues.duplicate(true)
	var cursor: Array = [0]
	for guard in range(100):
		var token_before: Dictionary = token.duplicate(true)
		result = Start.next_start(token,response,func(_tag: String) -> Variant:
			var unit: Variant = units[cursor[0]%units.size()]
			cursor[0]+=1
			return unit)
		check(equivalent(token,token_before),"continuation input read-only")
		if result["status"]!="READY": return result
		check(result["full_tick_complete"]==false,"no full combat tick claim")
		events.append_array(resolve(result["events"]))
		if result["done"]: break
		var command: Dictionary = result["command"]
		check(command["executed"]==false,"request never marked executed")
		response={"ack":true} # Contract fixture acknowledgment, not actual owner success.
		match command["command"]:
			"canMv": response["value"]=collision
			"safePt": response["value"]=safe
			"ensure_global_queue":
				if not queues.has(command["args"][0]): queues[command["args"][0]]=[]
			"append_global_queue": queues[command["args"][0]].append(command["args"][1].duplicate(true))
		if command["command"] not in ["canMv","safePt","ensure_global_queue","append_global_queue"]: cursor[0]+=nested
		token=result["continuation"]
	result["all_events"]=events
	result["queues"]=queues
	result["cursor"]=cursor[0]
	check(equivalent(enemy,before) and equivalent(context,context_before),"end inputs read-only")
	return result

func resolve(value: Variant) -> Variant:
	if value is Dictionary:
		if value.get("call")=="_T":
			var text: String = "translated:"+value["args"][0]
			if value.has("replace_first"):
				var pair: Array = value["replace_first"]
				var at: int = text.find(pair[0])
				if at>=0: text=text.substr(0,at)+pair[1]+text.substr(at+pair[0].length())
			return text
		var result: Dictionary = {}
		for key in value: result[key]=resolve(value[key])
		return result
	if value is Array:
		var result: Array = []
		for item in value: result.append(resolve(item))
		return result
	return value

func equivalent(a: Variant, b: Variant) -> bool:
	if a is Dictionary and b is Dictionary:
		if a.size()!=b.size(): return false
		for key in b:
			if not a.has(key) or not equivalent(a[key],b[key]): return false
		return true
	if a is Array and b is Array:
		if a.size()!=b.size(): return false
		for i in range(b.size()):
			if not equivalent(a[i],b[i]): return false
		return true
	if (a is int or a is float) and (b is int or b is float):
		if b==floor(float(b)): return a==b
		return abs(float(a)-float(b))<=1e-12*maxf(1.0,abs(float(b)))
	return typeof(a)==typeof(b) and a==b

func base_enemy() -> Dictionary:
	return {"ib":true,"etype":0,"_bossPhase":0,"x":0,"y":0,"r":44,"atk":46,"baseAtk":46,
		"el":0,"col":"#abcdef","facing":0.25,"s":"idle","st2":0,"poise":321,"maxPoise":1000,"reviveIframes":7}

func fixture(id: String, si: int=0, phase: int=0, d: float=100.0, extra: float=0.0) -> Dictionary:
	return consume(si,id,base_enemy(),d,phase,extra,{"thorn_first":false,"player_x":100,"player_y":0,"map_width":128,"map_height":108},[0.5])

func _test_anchors() -> void:
	scenario="independent-acceptance"
	check(fixture("fan")["enemy"]["st2"]==18,"fan phase0 tele18")
	check(fixture("fan",2)["enemy"]["st2"]==25,"face floor(18*1.4)=25")
	check(fixture("fan",2,0,100,7)["enemy"]["st2"]==35,"extraDelay before face factor")
	check(fixture("grab",0,0,119)["enemy"]["s"]=="bossGrabWind","grab d119")
	check(fixture("grab",0,0,120)["enemy"]["s"]=="bossChargeWind","grab d120 becomescharge")
	check(fixture("grab",2,0,120)["enemy"]["st2"]==41,"grab charge fallback bypassesface1.4")
	check(fixture("tailSwipe",2)["enemy"]["_isTail"]==true,"tail flag")
	var burrow: Dictionary = fixture("burrowStrike")
	check(burrow["enemy"]["st2"]==37 and burrow["enemy"]["_diveMax"]==37,"burrow phase0 max37")
	check(fixture("burrowStrike",0,4)["enemy"]["_diveMax"]==12,"burrow phase4 max12")
	var fissure: Dictionary = fixture("groundFissure")
	check(fissure["queues"]["_fissures"][0]["maxLen"]==2304 and absf(fissure["queues"]["_fissures"][0]["explR"]-691.2)<1e-12,"128x108 T40 source fissure values")
	var lava: Dictionary = fixture("lavaPools")
	check(lava["queues"]["_lavaPools"][0]["x"]==220 and lava["queues"]["_lavaPools"][1]["y"]==360 and lava["queues"]["_lavaPools"][2]["y"]==-360,"druid pools3 source axes")
	var elem: Dictionary = fixture("elemBall")
	var count: int=0
	for event: Dictionary in elem["all_events"]:
		if event["kind"]=="command" and event["value"]["command"]=="_spawnBossProjectile":
			count+=1
			check(event["value"]["args"][0]["parryClass"]=="magic" and not event["value"]["args"][0]["homing"],"normal druid request flags, no QE execution")
	check(count==10,"elemBall phase field0 produces10 requests")

func _test_missing_providers() -> void:
	scenario="provider-boundaries"
	var e: Dictionary = base_enemy()
	for si in [-1,4,34]: check(Start.begin_start(si,"burst",e,100,0)["status"]=="NOT_READY","unowned stage")
	for id in ["laser","cageTrap","teleStrike","missing"]: check(Start.begin_start(0,id,e,100,0)["status"]=="NOT_READY","no non-CH1 start cases")
	check(Start.begin_start(0,"fan",e,100,0)["status"]=="NOT_READY","no invented QA optin flag")
	check(Start.begin_start(0,"jump",e,100,0)["status"]=="NOT_READY","no dummy player")
	check(Start.begin_start(0,"burst",e,NAN,0)["status"]=="NOT_READY","nonfinite distance")
	check(Start.begin_start(0,"burst",e,100,5)["status"]=="NOT_READY","invalid phase")
	check(Start.next_start({})["status"]=="NOT_READY","no fake continuation")
	var first: Dictionary = Start.begin_start(0,"burst",e,100,0)
	var step: Dictionary = Start.next_start(first["continuation"])
	check(Start.next_start(step["continuation"])["status"]=="NOT_READY","owner acknowledgment required")
	var sweep: Dictionary = Start.begin_start(0,"sweep",e,100,0)
	check(Start.next_start(sweep["continuation"])["status"]=="NOT_READY","RNG provider required")
	for u in [-1,1,NAN,INF,true,null,"0.5"]:
		var calls: Array=[]
		var failed: Dictionary = Start.next_start(sweep["continuation"],null,func(tag: String) -> Variant:
			calls.append(tag)
			return u)
		check(failed["status"]=="NOT_READY" and failed["enemy"]==null,"bad RNG no applicable snapshot")
		check(calls.size()==1 and failed["rng_ledger"].size()==1,"attempt retained")
	var jump: Dictionary = Start.begin_start(0,"jump",e,100,0,0,{"player_x":100,"player_y":0})
	step=Start.next_start(jump["continuation"])
	check(Start.next_start(step["continuation"],{"ack":true})["status"]=="NOT_READY","missing collision readback is not false")

func _test_upstream_and_scope() -> void:
	scenario="upstream-and-protected-scope"
	var before_actions: Array[StringName] = InputMap.get_actions()
	var before_children: int = root.get_child_count()
	var before_fps: int = Engine.max_fps
	var before_locale: String = TranslationServer.get_locale()
	var packet: Dictionary = Spawn.build_spawn_packet({"si":0,"room":0,"player_level":1,"stage_diff_offset":0,"difficulty_index":0,"x":0,"y":0},func(_tag: String) -> float: return 0.5,func(_x: float,_y: float,_r: float) -> bool: return true)
	check(packet["status"]=="READY","actual BC02 fields")
	if packet["status"]!="READY": return
	var e: Dictionary = packet["fields"].duplicate(true)
	e["bossPatT"]=0
	var selected: Dictionary = Selector.select_tick(0,e,1,100,null,func(_tag: String) -> float: return 0.5)
	check(selected["status"]=="READY" and selected["start_pattern"]!=null,"BC04 selection request")
	if selected["status"]!="READY" or selected["start_pattern"]==null: return
	var request: Dictionary=selected["start_pattern"]
	var started: Dictionary=consume(0,request["move_id"],selected["enemy"],request["distance"],request["phase"],request["extra_delay"],{"thorn_first":false,"player_x":100,"player_y":0},[0.5])
	check(started["status"]=="READY" and started["done"],"BC04 request consumed to start packet")
	if started["status"]=="READY":
		for field: String in ["poise","reviveIframes","deaths","_revPts","eShield","baseAtk"]: check(started["enemy"][field]==selected["enemy"][field],"protected owner field unchanged: "+field)
	var recovery: Dictionary=Phase.clock_step(0,"recovery_switch",{"ib":true,"etype":0,"s":"recover","st2":30},1)
	check(recovery["enemy"]["st2"]==20,"BC05 later recovery boundary compatible")
	check(Start.source_receipt()["live_start_connected"]==false and Start.source_receipt()["combat_execution_verified"]==false,"no actual attack/Main claim")
	check(InputMap.get_actions()==before_actions and root.get_child_count()==before_children,"no input or actor/scene mutation")
	check(Engine.max_fps==before_fps and TranslationServer.get_locale()==before_locale,"no global clock or locale mutation")

func check(ok: bool, message: String) -> void:
	assertions+=1
	if not ok:
		failures+=1
		printerr("BC06_FAIL ",scenario," ",message)

func finish(code: int) -> void:
	print("BC06_RESULT ",JSON.stringify({"assertions":assertions,"failures":failures,"skipped":[],"source_cases":ORACLE_ROWS.size(),"source_events":source_events,"source_rng_draws":source_draws,"full_combat_evidence":false,"userdir":OS.get_user_data_dir()}))
	quit(code)

func _initialize() -> void:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--source-game="): path = ProjectSettings.globalize_path(preload("res://source_snapshot/snapshot.gd").PATH)
	call_deferred("_run")
func _run() -> void:
	var isolated: bool=ProjectSettings.get_setting("application/config/use_custom_user_dir",false)==true and ProjectSettings.get_setting("application/config/custom_user_dir_name","")==USERDIR and OS.get_user_data_dir().get_file()==USERDIR
	check(isolated,"custom settings and actual OS userdir exact")
	if not isolated:
		finish(2)
		return
	scope_before={"actions":InputMap.get_actions(),"children":root.get_child_count(),"fps":Engine.max_fps,"locale":TranslationServer.get_locale()}
	check(not path.is_empty() and FileAccess.get_sha256(path)==GAME_SHA256,"latest main source byte hash")
	for raw: String in PATTERNS:
		var row: Dictionary=JSON.parse_string(raw)
		scenario=row["name"]+":"+str(row["si"])+":"+row["mode"]+":"+str(row["enemy"].get("s"))
		mask=row["integer_paths"]
		var r: Dictionary=consume(row)
		check(r["status"]=="READY" and r.get("done",false),"producer READY/done "+str(r.get("reason")))
		if r["status"]!="READY": continue
		check(eq(r["enemy"],row["expected"]["enemy"],"/enemy"),"all source actor fields")
		check(eq(r["player"],row["expected"]["player"],"/player"),"protected player readback")
		check(eq(r["globals"],row["expected"]["globals"],"/globals"),"independent clocks/orb queue and compaction")
		check(eq(r["all_events"],row["expected"]["events"],"/events"),"source request/write/RNG exact order and sites")
		check(r["cursor"]==row["expected"]["cursor"],"source RNG cursor including canonical birth + nested helpers")
		check(r["drop_counter"]==row["expected"]["drop_counter"],"actual source-global drop sequence")
		source_events+=r["all_events"].size()
		for event: Dictionary in r["all_events"]:
			if event["kind"]=="rng": producer_draws+=1
	_test_starts()
	for id: int in STANDALONE:
		scenario="canonical-standalone-"+str(id)
		var bc: Dictionary=JSON.parse_string(BIRTHS[id])
		var cursor: Array=[int(bc["cursor_before"])]
		birth(bc,cursor)
	_test_contract_failures()
	_test_anchors_and_scope()
	finish(0 if failures==0 else 1)
func consume(row: Dictionary) -> Dictionary:
	var before: Dictionary=row.duplicate(true)
	var begin: Dictionary=Shots.begin_pattern(int(row["si"]),row["mode"],row["enemy"],row["player"],row["sp"],row["context"],row["globals"])
	check(begin["status"]=="READY","begin source checkpoint")
	if begin["status"]!="READY": return begin
	var token: Dictionary=begin["continuation"]
	var reply: Variant=null
	var cursor: Array=[0]
	var events: Array=[]
	var spawn_index: int=0
	var contact_index: int=0
	var r: Dictionary={}
	for guard in range(80):
		var saved: Dictionary=token.duplicate(true)
		r=Shots.next_pattern(token,reply,func(_tag: String) -> Variant:
			var u: Variant=row["units"][cursor[0]%row["units"].size()]
			cursor[0]+=1
			return u)
		check(token==saved,"producer continuation readonly")
		if r["status"]!="READY": return r
		check(r["full_tick_complete"]==false,"not a complete tick or live combat")
		events.append_array(r["events"])
		if r["done"]: break
		var command: Dictionary=r["command"]
		check(command["executed"]==false,"request not live execution")
		reply={"ack":true}
		if command["command"]=="spawnProj_owner":
			check(spawn_index<row["spawn_ids"].size(),"source spawn birth record exists")
			if spawn_index>=row["spawn_ids"].size(): return {"status":"NOT_READY","reason":"fixture_extra_spawn"}
			var bc: Dictionary=JSON.parse_string(BIRTHS[int(row["spawn_ids"][spawn_index])])
			check(eq(command["args"][0],bc["props"]),"prepared source wrapper/direct props")
			check(cursor[0]==bc["cursor_before"],"normalizer entered at source RNG boundary")
			var born: Dictionary=birth(bc,cursor,command["args"][0])
			if born["status"]!="READY": return born
			reply["projectile_result"]=born["projectile"]
			reply["drop_before"]=bc["drop_before"]
			reply["drop_after"]=born["drop_counter"]
			spawn_index+=1
		elif command["command"]=="resolve_druid_orb_contact":
			check(contact_index<row["contacts"].size(),"original protected ORB readback exists")
			if contact_index>=row["contacts"].size(): return {"status":"NOT_READY","reason":"fixture_extra_contact"}
			var owner: Dictionary=row["contacts"][contact_index]
			reply.merge(owner)
			cursor[0]=int(owner["cursor_after"])
			contact_index+=1
			source_contacts+=1
		else: cursor[0]+=int(row["nested"])
		token=r["continuation"]
	check(row==before,"all producer input snapshots readonly")
	check(spawn_index==row["spawn_ids"].size() and contact_index==row["contacts"].size(),"all source boundaries consumed")
	r["all_events"]=events
	r["cursor"]=cursor[0]
	return r
func birth(bc: Dictionary,cursor: Array,actual_props: Variant=null) -> Dictionary:
	var before: Dictionary=bc.duplicate(true)
	var props: Dictionary=bc["props"] if actual_props==null else actual_props
	var props_before: Dictionary=props.duplicate(true)
	var r: Dictionary=Shots.begin_birth(props,bc["context"])
	check(r["status"]=="READY","source birth inputs present")
	if r["status"]!="READY": return r
	var reply: Variant=null
	var classes: int=0
	var ledger: Array=[]
	for guard in range(8):
		if r["done"]: break
		var token: Dictionary=r["continuation"]
		var saved: Dictionary=token.duplicate(true)
		r=Shots.next_birth(token,reply,func(_tag: String) -> Variant:
			var u: Variant=bc["units"][cursor[0]%bc["units"].size()]
			cursor[0]+=1
			return u)
		check(token==saved,"birth continuation readonly")
		if r["status"]!="READY": return r
		ledger.append_array(r["rng_ledger"])
		if not r["done"]:
			check(r["command"]["command"]=="projectile_class_authority" and r["command"]["executed"]==false,"class delegated, no local QE classifier")
			check(classes<bc["class_responses"].size(),"source class reader record exists")
			if classes>=bc["class_responses"].size(): return {"status":"NOT_READY","reason":"extra_class_query"}
			var authority: Dictionary=bc["class_responses"][classes]
			check(close(observe(r["command"]["args"][0]),authority["snapshot"]),"pre/post poison class query preserves exact source state")
			reply={"ack":true,"value":authority["value"]}
			classes+=1
	check(r["done"] and r["live_spawn_verified"]==false,"birth math completed, no actual projectile append proof")
	check(classes==bc["class_responses"].size(),"class authority boundaries consumed")
	check(close(observe(r["projectile"]),bc["expected"]),"source canonical numeric/flag/class projection")
	check(r["drop_counter"]==bc["drop_after"],"global modulo counter result")
	check(r["pool_action"]==("none" if bc["pool_snapshot"]==null else ("recycle_requested" if bc["expected"]==null else "append_requested")),"source lesson/recycle/append request")
	check(close(ledger,bc["rng"]),"source normalizer RNG sites and units, including physical fixed-speed draw")
	check(cursor[0]==bc["cursor_after"],"canonical birth RNG cursor")
	check(bc==before and props==props_before,"actual producer birth inputs readonly")
	birth_count+=1
	birth_draws+=ledger.size()
	return r
func observe(p: Variant) -> Variant:
	if p==null: return null
	var o: Dictionary={}
	for k in NUMBER_KEYS: o[k]=p[k]
	for k in FLAG_KEYS: o[k]=p.get(k,false)==true
	o["col"]=p["col"]
	o["parryClass"]=p["parryClass"]
	o["_druidThornLane"]=p["_druidThornLane"]
	return o
func eq(a: Variant,b: Variant,p: String="") -> bool:
	if a is Dictionary and b is Dictionary:
		if a.size()!=b.size(): return false
		for k in b:
			if not a.has(k) or not eq(a[k],b[k],p+"/"+str(k)): return false
		return true
	if a is Array and b is Array:
		if a.size()!=b.size(): return false
		for i in range(b.size()):
			if not eq(a[i],b[i],p+"/"+str(i)): return false
		return true
	if (a is int or a is float) and (b is int or b is float):
		if mask.has(p): return a==b
		return abs(float(a)-float(b))<=1e-12*maxf(1,abs(float(b)))
	return typeof(a)==typeof(b) and a==b
func close(a: Variant,b: Variant) -> bool:
	var saved: Dictionary=mask
	mask={}
	var ok: bool=eq(a,b)
	mask=saved
	if a is Dictionary and b is Dictionary:
		for k in ["dmg","el","life","ml","_druidThornLane"]:
			if b.has(k) and b[k]!=null and b[k]==floor(float(b[k])): ok=ok and a.get(k)==b[k]
	return ok
func _test_starts() -> void:
	for raw: String in STARTS:
		var row: Dictionary=JSON.parse_string(raw)
		scenario="BC06-actual-"+row["id"]+":"+str(row["si"])
		var begin: Dictionary=Start.begin_start(int(row["si"]),row["id"],row["enemy"],1000,int(row["enemy"]["_bossPhase"]),0,{"player_x":row["player"]["x"],"player_y":row["player"]["y"]})
		check(begin["status"]=="READY","actual BC06 start packet")
		if begin["status"]!="READY": continue
		var token: Dictionary=begin["continuation"]
		var reply: Variant=null
		var index: int=0
		var cursor: Array=[0]
		for guard in range(50):
			var r: Dictionary=Start.next_start(token,reply)
			check(r["status"]=="READY","actual BC06 step")
			if r["status"]!="READY": break
			if r["done"]: break
			var cmd: Dictionary=r["command"]
			if cmd["command"]=="_spawnBossProjectile":
				check(index<row["raw"].size(),"source start raw request exists")
				var original: Dictionary=row["raw"][index]
				check(close(cmd["args"][0],original["raw"]),"BC06 elem/rapid raw request exact")
				var bc: Dictionary=JSON.parse_string(BIRTHS[int(row["spawn_ids"][index])])
				var context: Dictionary=row["context"].duplicate(true)
				context["start_command"]=cmd
				context["drop_counter"]=bc["drop_before"]
				var relay: Dictionary=Shots.begin_pattern(int(row["si"]),"start_request",r["enemy"],row["player"],1,context)
				var pending: Dictionary=Shots.next_pattern(relay["continuation"])
				check(pending["status"]=="READY" and close(pending["command"]["args"][0],bc["props"]),"BC09 wrapper relay, no duplicated BC06 start logic")
				var born: Dictionary=birth(bc,cursor,pending["command"]["args"][0])
				if born["status"]!="READY": break
				var done: Dictionary=Shots.next_pattern(pending["continuation"],{"ack":true,"projectile_result":born["projectile"],"drop_before":bc["drop_before"],"drop_after":born["drop_counter"]})
				check(done["status"]=="READY" and done["done"],"actual owner receipt required before relay done")
				index+=1
			else:
				if cmd["command"]!="_T": cursor[0]+=int(row["nested"])
			reply={"ack":true}
			if cmd["command"]=="_T": reply["value"]="translated:"+cmd["args"][0]
			token=r["continuation"]
		check(index==row["raw"].size(),"all BC06 projectile requests relayed")
func actor(state: String="bossBurstWind") -> Dictionary: return {"ib":true,"alive":true,"etype":0,"s":state,"x":0,"y":0,"r":44,"hp":1000,"st2":0,"facing":0,"atk":46,"el":0,"col":"#bbbbbb","_bossPhase":0}
func player() -> Dictionary: return {"x":100,"y":0,"r":12,"iframes":0,"s":"idle"}
func _test_contract_failures() -> void:
	scenario="missing authority/readback"
	check(Shots.begin_pattern(4,"state",actor(),player(),1)["status"]=="NOT_READY","no chapter2")
	var begin: Dictionary=Shots.begin_pattern(0,"state",actor(),player(),1,{"thorn_first":false}, {})
	check(Shots.next_pattern(begin["continuation"],null,func(_tag: String) -> float: return 0.5)["status"]=="NOT_READY","no default global drop counter")
	begin=Shots.begin_pattern(0,"state",actor(),player(),1,{"thorn_first":false,"drop_counter":0},{})
	var pending: Dictionary=Shots.next_pattern(begin["continuation"],null,func(_tag: String) -> float: return 0.5)
	check(pending["status"]=="READY" and pending["command"]["command"]=="spawnProj_owner","raw request is not an accepted projectile")
	check(Shots.next_pattern(pending["continuation"],{"ack":true})["status"]=="NOT_READY","ACK alone cannot invent spawn result/counter")
	check(Shots.next_pattern(pending["continuation"],{"ack":true,"projectile_result":{},"drop_before":0,"drop_after":1})["status"]=="NOT_READY","empty accepted birth snapshot cannot substitute for actual source projectile")
	check(Shots.next_pattern(pending["continuation"],{"ack":true,"projectile_result":null,"drop_before":1,"drop_after":2})["status"]=="NOT_READY","global counter continuity enforced")
	var bc: Dictionary=JSON.parse_string(BIRTHS[0])
	check(Shots.begin_birth(bc["props"],{})["status"]=="NOT_READY","no implicit lesson/counter/pool")
	var bad: Dictionary=bc["context"].duplicate(true)
	bad.erase("pool_snapshot")
	check(Shots.begin_birth(bc["props"],bad)["status"]=="NOT_READY","actual reset/fresh pool snapshot required")
	begin=Shots.begin_birth(bc["props"],bc["context"])
	pending=Shots.next_birth(begin["continuation"])
	check(pending["status"]=="READY" and pending["command"]["command"]=="projectile_class_authority","class delegated")
	check(Shots.next_birth(pending["continuation"])["status"]=="NOT_READY","missing actual class reply not mock physical")
	check(Shots.next_birth(pending["continuation"],{"ack":true,"value":"blue"})["status"]=="NOT_READY","unsupported class not guessed")
	begin=Shots.begin_pattern(0,"state",actor("bossBeanStormWind"),player(),1)
	check(Shots.next_pattern(begin["continuation"])["status"]=="NOT_READY","no default RNG")
	for u: Variant in [-0.1,1.0,NAN,"0.5"]:
		var r: Dictionary=Shots.next_pattern(begin["continuation"],null,func(_tag: String) -> Variant: return u)
		check(r["status"]=="NOT_READY" and r["rng_ledger"].size()==1,"bad consumed unit retained")
	var orb: Dictionary={"x":100,"y":0,"vx":0,"vy":0,"t":0,"r":26,"dmg":27}
	begin=Shots.begin_pattern(0,"orbs",actor(),player(),1,{}, {"bossAlive":true,"_druidOrbT":0,"_druidOrbs":[orb],"mw":128,"mh":108})
	pending=Shots.next_pattern(begin["continuation"])
	check(pending["command"]["command"]=="resolve_druid_orb_contact","protected ORB contact delegated")
	check(Shots.next_pattern(pending["continuation"],{"ack":true})["status"]=="NOT_READY","no fake Q/E/AOE/HP readback")
func _test_anchors_and_scope() -> void:
	scenario="independent source anchors"
	var counts: Array=[]
	var poison_physical: bool=false
	var poison_magic: bool=false
	var generic_direct: bool=false
	var stationary: bool=false
	var orb40: bool=false
	for raw: String in PATTERNS:
		var row: Dictionary=JSON.parse_string(raw)
		if row["name"]=="druid-fan-count" and row["context"]["thorn_first"]==false: counts.append(row["spawn_ids"].size())
		for event: Dictionary in row["expected"]["events"]:
			if event["kind"]=="command" and event["value"]["command"]=="resolve_druid_orb_contact":
				if event["value"]["args"][0]["aoe_damage"]==40: orb40=true
	for raw: String in BIRTHS:
		var bc: Dictionary=JSON.parse_string(raw)
		var born: Variant=bc["expected"]
		if born==null: continue
		if bc["props"]["dmg"]==59 and born["_druidPoison"]:
			if born["parryClass"]=="physical" and born["dmg"]==59: poison_physical=true
			if born["parryClass"]=="magic" and born["dmg"]==118: poison_magic=true
		if bc["props"].get("_commit",false) and not born["_druidPoison"]: generic_direct=true
		if bc["props"]["vx"]==0 and bc["props"]["vy"]==0 and born["dmg"]==bc["props"]["dmg"]: stationary=true
	check(counts==[10,12,13,14,16],"source default druid fan phase counts")
	check(poison_physical and poison_magic,"raw59 -> birth physical59/magic118 from source authority replies")
	check(generic_direct,"generic direct spawn does not inject poison wrapper")
	check(stationary,"stationary birth has no moving damage multiplier")
	check(orb40,"raw27 source ORB AOE max40")
	check(birth_count==BIRTHS.size(),"all source birth records verified exactly once")
	check(InputMap.get_actions()==scope_before["actions"] and root.get_child_count()==scope_before["children"] and Engine.max_fps==scope_before["fps"] and TranslationServer.get_locale()==scope_before["locale"],"scene/input/global settings unchanged")
	check(not Shots.source_receipt()["live_spawn_connected"] and not Shots.source_receipt()["class_or_QE_execution_verified"],"no live birth/QE proof claim")
func check(ok: bool,message: String) -> void:
	assertions+=1
	if not ok:
		failures+=1
		printerr("BC09_FAIL ",scenario," ",message)
func finish(code: int) -> void:
	print("BC09_RESULT ",JSON.stringify({"assertions":assertions,"failures":failures,"skipped":[],"source_cases":PATTERNS.size(),"source_events":source_events,"producer_rng_draws":producer_draws,"birth_cases":birth_count,"birth_rng_draws":birth_draws,"start_cases":STARTS.size(),"protected_orb_contacts":source_contacts,"live_spawn_or_QE_evidence":false,"userdir":OS.get_user_data_dir()}))
	quit(code)

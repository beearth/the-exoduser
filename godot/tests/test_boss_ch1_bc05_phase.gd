var assertions: int = 0
var failures: int = 0
var scenario: String = "isolation"
var source_path: String = ProjectSettings.globalize_path(preload("res://source_snapshot/snapshot.gd").PATH)
var source_draws: int = 0
var source_continuations: int = 0

func _initialize() -> void:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--source-game="): source_path = ProjectSettings.globalize_path(preload("res://source_snapshot/snapshot.gd").PATH)
	call_deferred("_run")

func _run() -> void:
	var isolated: bool = ProjectSettings.get_setting("application/config/use_custom_user_dir", false) == true \
		and ProjectSettings.get_setting("application/config/custom_user_dir_name", "") == USERDIR \
		and OS.get_user_data_dir().get_file() == USERDIR
	check(isolated, "exact setting and actual OS userdir")
	if not isolated:
		finish(2)
		return
	check(not source_path.is_empty() and FileAccess.get_sha256(source_path) == GAME_SHA256, "latest main source hash")
	for raw: String in ORACLE_ROWS:
		var row: Dictionary = JSON.parse_string(raw)
		var enemy: Dictionary = row["enemy"]
		enemy["_bossPhase"] = int(enemy["_bossPhase"])
		var before: Dictionary = enemy.duplicate(true)
		var context_before: Dictionary = row["context"].duplicate(true)
		scenario = row["name"] + ":" + row["method"] + ":phase" + str(enemy["_bossPhase"])
		var calls: Array = []
		var rng: Callable = func(tag: String) -> Variant:
			calls.append(tag)
			return row["unit"]
		var packet: Dictionary
		if row["method"] == "phase": packet = Phase.phase_transition(int(row["si"]), enemy)
		else: packet = Phase.clock_step(int(row["si"]), row["method"], enemy, row["sp"], row["context"], rng)
		check(packet["status"] == "READY", "source packet READY: " + str(packet.get("reason")))
		if packet["status"] != "READY": continue
		for field: String in ["enemy", "write_keys", "commands", "rng_ledger", "continuation_required"]:
			check(equivalent(packet[field], row["expected"][field]), "source " + field)
		check(packet["full_tick_complete"] == false, "no whole updateE claim")
		check(equivalent(enemy, before) and equivalent(row["context"], context_before), "input snapshots read-only")
		check(calls.size() == row["expected"]["rng_ledger"].size(), "actual callback count")
		if row["expected"]["returns_update"]: check(packet["next_boundary"] == "return_update", "original upper return blocks later phase")
		if packet["continuation_required"]:
			source_continuations += 1
			check(packet["next_boundary"] == "phase_effects_required" and packet["commands"][0]["executed"] == false, "effects handed off before later dispatch")
		source_draws += calls.size()
	_test_effects()
	_test_anchors()
	_test_missing_inputs()
	_test_bc02_bc04_and_scope()
	finish(0 if failures == 0 else 1)

func equivalent(actual: Variant, expected: Variant) -> bool:
	if actual is Dictionary and expected is Dictionary:
		if actual.size() != expected.size(): return false
		for key in expected:
			if not actual.has(key) or not equivalent(actual[key], expected[key]): return false
		return true
	if actual is Array and expected is Array:
		if actual.size() != expected.size(): return false
		for i in range(expected.size()):
			if not equivalent(actual[i], expected[i]): return false
		return true
	if (actual is int or actual is float) and (expected is int or expected is float):
		if expected == floor(float(expected)): return actual == expected
		return abs(float(actual) - float(expected)) <= 1e-12 * maxf(1.0, abs(float(expected)))
	return typeof(actual) == typeof(expected) and actual == expected

func base_enemy() -> Dictionary:
	return {"_bossPhase": 0, "hp": 800, "mhp": 1000, "atk": 46, "baseAtk": 46,
		"speed": 0.5, "maxPoise": 1000, "poise": 321, "poiseR": 9, "bossPatCd": 35,
		"stunned": 0, "s": "idle", "st2": 10, "ib": true, "alive": true, "etype": 0,
		"x": 0, "y": 0, "kb": {"x": 3, "y": 4}, "_aAtkM": 1.0}

func _test_effects() -> void:
	for raw: String in EFFECT_ROWS:
		var row: Dictionary = JSON.parse_string(raw)
		scenario = "phase-effects:" + str(row["phase"]) + ":" + row["scenario"]
		row["enemy"]["_bossPhase"] = int(row["enemy"]["_bossPhase"])
		var before: Dictionary = row["enemy"].duplicate(true)
		var started: Dictionary = Phase.begin_phase_effects(int(row["si"]), row["enemy"], row["player"])
		check(started["status"] == "READY", "effects start requires real input snapshots")
		if started["status"] != "READY": continue
		var token: Dictionary = started["continuation"]
		var response: Variant = null
		var cursor: Array = [0]
		var commands: Array = []
		var ledger: Array = []
		var result: Dictionary = {}
		for guard in range(120):
			var token_before: Dictionary = token.duplicate(true)
			result = Phase.phase_effect_step(token, response, func(_tag: String) -> Variant:
				var u: Variant = row["units"][cursor[0] % row["units"].size()]
				cursor[0] += 1
				return u)
			check(equivalent(token, token_before), "effect continuation input read-only")
			check(result["status"] == "READY", "effect step READY: " + str(result.get("reason")))
			if result["status"] != "READY": break
			ledger.append_array(result["rng_ledger"])
			check(result["full_tick_complete"] == false, "effects stream is not full updateE/damage proof")
			if result["done"]: break
			var command: Dictionary = result["command"]
			commands.append(command)
			check(command["executed"] == false, "request is not reported as executed")
			# Fixture acknowledgments test the protocol only, not the real owners.
			response = {"ack": true}
			match command["command"]:
				"canMv": response["value"] = row["collision_ok"]
				"safePt": response["value"] = row["safe_point"]
				"hurtP": response["player_after"] = row["player_after_hurt"]
				"_T": response["value"] = "translated:" + command["args"][0]
				"_reviveVFX":
					response["slow_mo_after"] = row["slow_mo_after"]
					response["hit_stop_scale"] = row["hit_stop_scale"]
				"_bossSfx": response["value"] = row["sfx"]
			if command["command"] in ["poolPart", "_addBlastLight", "_addTpSmoke", "_addTpImpact", "_addTpBolt", "hurtP", "_spawnBossProjectile", "addTxt", "_reviveVFX", "shake", "SFX.groggy"]:
				cursor[0] += int(row["nested_draws"])
			token = result["continuation"]
		check(result.get("done", false), "bounded stream reaches source return")
		check(equivalent(commands, row["expected"]["commands"]), "all original effect call arguments and order")
		check(equivalent(ledger, row["expected"]["ledger"]), "local RNG site/unit sequence including nested owner interleaving")
		check(cursor[0] == row["expected"]["cursor"], "actual shared unit cursor")
		if result.get("done", false): check(equivalent(result["enemy"], row["expected"]["enemy"]), "teleport/flash exact source next state")
		check(equivalent(row["enemy"], before), "effects never mutate original actor")
	# Missing owner acknowledgments/readback cannot continue the phase silently.
	var actor: Dictionary = base_enemy()
	actor["_bossPhase"] = 1
	actor["r"] = 44
	actor["el"] = 0
	var start: Dictionary = Phase.begin_phase_effects(0, actor, {"x": 100, "y": 200, "facing": 0, "iframes": 0, "s": "idle"})
	var first: Dictionary = Phase.phase_effect_step(start["continuation"], null, func(_tag: String) -> float: return 0.5)
	check(Phase.phase_effect_step(first["continuation"])["status"] == "NOT_READY", "VFX owner ack required before next RNG")
	check(Phase.phase_effect_step({})["status"] == "NOT_READY", "no fabricated continuation")
	check(Phase.begin_phase_effects(0, actor, {})["status"] == "NOT_READY", "no dummy player for effects")
	var broken: Dictionary = start["continuation"].duplicate(true)
	broken["pending"] = "hurtP"
	check(Phase.phase_effect_step(broken, {"ack": true})["status"] == "NOT_READY", "post-damage player readback required")
	broken["pending"] = "revive_vfx"
	check(Phase.phase_effect_step(broken, {"ack": true})["status"] == "NOT_READY", "post-VFX actual global readback required")
	broken["pending"] = "canMv"
	check(Phase.phase_effect_step(broken, {"ack": true})["status"] == "NOT_READY", "collision false differs from missing reader")
	var failed: Dictionary = Phase.phase_effect_step(start["continuation"], null, func(_tag: String) -> float: return 1.0)
	check(failed["status"] == "NOT_READY" and failed["enemy"] == null and failed["rng_ledger"].size() == 1, "bad effect draw retains ledger and no applicable state")

func _test_anchors() -> void:
	scenario = "exact-acceptance"
	var e: Dictionary = base_enemy()
	var packet: Dictionary = Phase.phase_transition(0, e)
	var next: Dictionary = packet["enemy"]
	check(next["_bossPhase"] == 1 and next["hp"] == 800, "mhp1000/hp800 exact .8 enters phase1")
	check(next["reviveIframes"] == 90 and next["bossPatCd"] == 29, "iframe90 and patCd35 to29")
	check(next["atk"] == 59 and next["maxPoise"] == 1200 and next["poise"] == 321 and next["poiseR"] == 9, "one buff, current poise untouched")
	check(next["st2"] == 45 and next["s"] == "recover" and next["bossPatT"] == 10, "authored phase recovery45")
	check(not packet["write_keys"].has("poise") and not packet["write_keys"].has("baseAtk"), "protected/current poise and base attack not written")
	check(packet["continuation_required"] and packet["commands"].size() == 1, "real phase effects still required")
	# An isolated later-checkpoint fixture; this does not execute the intervening effects.
	packet = Phase.clock_step(0, "recovery_switch", next, 1)
	check(packet["enemy"]["st2"] == 20 and packet["enemy"]["s"] == "recover", "same tick switch clamps45 to20")
	check(packet["commands"][0]["command"] == "atkTicketRelease" and packet["commands"][0]["executed"] == false, "existing ticket release delegated, not a new ticket system")
	packet = Phase.clock_step(0, "attack_reset", packet["enemy"], 1)
	check(packet["enemy"]["atk"] == 46, "next attack checkpoint resets tobase46, no permanent1.3")
	e["hp"] = 199
	packet = Phase.phase_transition(0, e)
	check(packet["enemy"]["_bossPhase"] == 4 and packet["enemy"]["hp"] == 200, "hp199 jumps once tophase4/hp200")
	check(packet["enemy"]["atk"] == 59 and packet["enemy"]["maxPoise"] == 1200, "skipped phases do not stack buffs")
	for state in ["recover", "bossRec"]:
		e = base_enemy()
		e["s"] = state
		e["st2"] = 45
		packet = Phase.clock_step(0, "recovery_switch", e, 1)
		check(packet["enemy"]["st2"] == (20 if state == "recover" else 45), "bossRec differs from recover clamp")
		e["st2"] = 0
		packet = Phase.clock_step(0, "recovery_switch", e, 1, {}, func(_tag: String) -> float: return 0.5)
		check(packet["enemy"]["st2"] == 5.5 and packet["enemy"]["s"] == "idle", "idle timer is3+u5 with no floor")
	e = base_enemy()
	e["_feinting"] = true
	e["s"] = "bossFanWind"
	e["st2"] = 0
	packet = Phase.clock_step(0, "after_ai_feint", e, 1)
	check(packet["enemy"]["st2"] == 25 and packet["enemy"]["_feinting"] == false, "expired Wind feint cancel25")
	packet = Phase.clock_step(0, "recovery_switch", packet["enemy"], 1)
	check(packet["enemy"]["st2"] == 20, "same state switch then clamps feint25 to20")
	# ~~ wraps signed32; this is not an invented floor at large HP or negative atk.
	e = base_enemy()
	e["mhp"] = 4294967296.0
	e["hp"] = 100.0
	e["atk"] = -46.9
	packet = Phase.phase_transition(0, e)
	check(packet["enemy"]["hp"] == 858993459 and packet["enemy"]["atk"] == -60, "JS ToInt32 and trunc toward zero")

func _test_missing_inputs() -> void:
	scenario = "unsupported-and-provider-boundaries"
	var e: Dictionary = base_enemy()
	for si in [-1, 4, 34]: check(Phase.phase_transition(si, e)["status"] == "NOT_READY", "unsupported CH1 stage")
	for change in [{"mhp": 0}, {"hp": NAN}, {"_bossPhase": 5}, {"atk": "46"}, {"_moveCDs": {}}]:
		var bad: Dictionary = e.duplicate(true)
		bad.merge(change, true)
		var packet: Dictionary = Phase.phase_transition(0, bad)
		check(packet["status"] == "NOT_READY" and packet["enemy"] == null, "no invented phase state")
	# A no-change phase does not eagerly require stats/providers unused by the source gate.
	check(Phase.phase_transition(0, {"_bossPhase": 4, "hp": 100, "mhp": 1000})["status"] == "READY", "phase gate precedes stat reads")
	check(Phase.clock_step(0, "unknown", e, 1)["status"] == "NOT_READY", "unknown checkpoint")
	check(Phase.clock_step(0, "telegraph", e, INF)["status"] == "NOT_READY", "bad delta")
	check(Phase.clock_step(0, "after_projectile_charge", e, 1)["status"] == "NOT_READY", "flow provider absence not null flow")
	check(Phase.clock_step(0, "after_projectile_charge", e, 1, {"flow_direction": null})["status"] == "NOT_READY", "fallback player snapshot required")
	e["_lessonEnemy"] = true
	check(Phase.clock_step(0, "lesson_gate", e, 1)["status"] == "NOT_READY", "lesson active reader required")
	e = base_enemy()
	e["s"] = "recover"
	e["st2"] = 0
	check(Phase.clock_step(0, "recovery_switch", e, 1)["status"] == "NOT_READY", "expired recovery requires real RNG")
	for unit in [-1.0, 1.0, NAN, INF, null, true, "0.5"]:
		var calls: Array = []
		var packet: Dictionary = Phase.clock_step(0, "recovery_switch", e, 1, {}, func(tag: String) -> Variant:
			calls.append(tag)
			return unit)
		check(packet["status"] == "NOT_READY" and packet["enemy"] == null, "invalid unit no state")
		check(calls.size() == 1 and packet["rng_ledger"].size() == 1, "invalid consumed attempt retained")
	var packet: Dictionary = Phase.clock_step(0, "recovery_switch", e, 1, {}, func(_tag: String) -> float: return 1.0 - 1.0 / 9007199254740992.0)
	check(packet["status"] == "READY" and packet["enemy"]["st2"] > 7.9, "max legal unit accepted")

func _test_bc02_bc04_and_scope() -> void:
	scenario = "upstream-and-scope"
	var input_actions: Array[StringName] = InputMap.get_actions()
	var before_children: int = root.get_child_count()
	var before_fps: int = Engine.max_fps
	var before_locale: String = TranslationServer.get_locale()
	var spawn: Dictionary = Spawn.build_spawn_packet({"si": 0, "room": 0, "player_level": 1, "stage_diff_offset": 0,
		"difficulty_index": 0, "x": 100, "y": 100}, func(_tag: String) -> float: return 0.5,
		func(_x: float, _y: float, _r: float) -> bool: return true)
	check(spawn["status"] == "READY", "actual BC02 source packet")
	if spawn["status"] != "READY": return
	var e: Dictionary = spawn["fields"].duplicate(true)
	var before: Dictionary = e.duplicate(true)
	e["hp"] = e["mhp"] * 0.8
	var packet: Dictionary = Phase.phase_transition(0, e)
	check(packet["status"] == "READY" and packet["enemy"]["_bossPhase"] == 1, "BC02 packet enters phase")
	check(packet["enemy"]["poise"] == before["poise"] and packet["enemy"]["eShield"] == before["eShield"], "poise and shield remain source-owned")
	for field: String in ["deaths", "_revPts", "_maxRevPts", "eShieldMax", "baseAtk"]:
		check(packet["enemy"][field] == before[field] and not packet["write_keys"].has(field), "revival/damage owner unchanged: " + field)
	var phase_copy: Dictionary = packet["enemy"].duplicate(true)
	packet["enemy"]["_moveCDs"][0] = 999
	check(e["_moveCDs"][0] == 0, "returned CD deep copy")
	# BC04/BC05 contract at a later owner-resolved snapshot, not an actual combat tick.
	phase_copy["s"] = "idle"
	phase_copy["bossPatT"] = 0
	var selected: Dictionary = Selector.select_tick(0, phase_copy, 1, 100, null, func(_tag: String) -> float: return 0.5)
	check(selected["status"] == "READY" and selected["start_pattern"]["phase"] == 1, "BC04 reads phase1 and reset CDs")
	check(Phase.source_receipt()["live_tick_connected"] == false and Phase.source_receipt()["damage_or_iframe_execution_verified"] == false, "no live clock or immunity claim")
	check(InputMap.get_actions() == input_actions and root.get_child_count() == before_children, "no action or actor/scene mutation")
	check(Engine.max_fps == before_fps and TranslationServer.get_locale() == before_locale, "no clock settings or locale mutation")

func check(ok: bool, message: String) -> void:
	assertions += 1
	if not ok:
		failures += 1
		printerr("BC05_FAIL ", scenario, " ", message)

func finish(code: int) -> void:
	print("BC05_RESULT ", JSON.stringify({"assertions": assertions, "failures": failures, "skipped": [],
		"source_cases": ORACLE_ROWS.size(), "effect_cases": EFFECT_ROWS.size(), "source_rng_draws": source_draws, "phase_continuations": source_continuations,
		"full_tick_or_damage_evidence": false, "userdir": OS.get_user_data_dir()}))
	quit(code)

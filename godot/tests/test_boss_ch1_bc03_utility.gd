var assertions: int = 0
var failures: int = 0
var groups: Array = []
var current_group: String = ""
var source_path: String = ""

func _initialize() -> void:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--source-game="): source_path = arg.trim_prefix("--source-game=")
	call_deferred("_run")

func _run() -> void:
	current_group = "isolation"
	var isolated: bool = ProjectSettings.get_setting("application/config/use_custom_user_dir", false) == true 		and ProjectSettings.get_setting("application/config/custom_user_dir_name", "") == USERDIR 		and OS.get_user_data_dir().get_file() == USERDIR
	check(isolated, "exact settings and actual OS userdir")
	if not isolated:
		finish(2)
		return
	check(not source_path.is_empty() and FileAccess.get_sha256(source_path) == GAME_SHA256, "latest source hash matches independent fixture")
	for name: String in GROUPS:
		current_group = name
		var before: int = assertions
		var failed_before: int = failures
		call("_test_" + name)
		check(assertions > before, "group must execute assertions")
		var row: Dictionary = {"group": name, "assertions": assertions - before, "failures": failures - failed_before}
		groups.append(row)
		print("BC03_GROUP ", JSON.stringify(row))
	finish(0 if failures == 0 else 1)

func finish(code: int) -> void:
	print("BC03_RESULT ", JSON.stringify({"assertions": assertions, "failures": failures,
		"skipped": [], "groups": groups, "source_cases": SOURCE_CASES.size(),
		"public_play_evidence": false, "userdir": OS.get_user_data_dir()}))
	quit(code)

func check(ok: bool, message: String) -> void:
	assertions += 1
	if not ok:
		failures += 1
		printerr("BC03_FAIL ", current_group, " ", message)

func evaluate(si: int, move: Dictionary, d: float, ps: Variant, phase: int,
		enemy: Dictionary, unit: Variant = 0.5) -> Dictionary:
	var calls: Array = []
	var rng: Callable = func(field: String) -> Variant:
		calls.append(field)
		return unit
	var result: Dictionary = Utility.evaluate_move(si, move, d, ps, phase, enemy, rng)
	return {"result": result, "calls": calls}

func _test_source_6577_scores_and_draws() -> void:
	check(SOURCE_CASES.size() == 6577 and SOURCE_MOVES.size() == 60, "source dimensions include one isolated math probe")
	for i in range(SOURCE_CASES.size()):
		var c: Array = SOURCE_CASES[i]
		var move: Dictionary = SOURCE_MOVES[c[1]].duplicate(true)
		var ps: Variant = SOURCE_PS[c[4]].duplicate(true) if SOURCE_PS[c[4]] is Dictionary else null
		var enemy: Dictionary = SOURCE_ENEMIES[c[5]].duplicate(true)
		var before: Array = [move.duplicate(true), ps.duplicate(true) if ps is Dictionary else null, enemy.duplicate(true)]
		var run: Dictionary = evaluate(c[0], move, c[2], ps, c[3], enemy, c[6])
		var result: Dictionary = run["result"]
		check(result["status"] == "READY", "case%d source-ready: %s" % [i, result.get("reason", "")])
		if result["status"] != "READY": continue
		check(absf(float(result["score"]) - float(c[7])) <= 1e-12, "case%d score source=%s actual=%s" % [i, c[7], result["score"]])
		check(run["calls"].size() == c[8] and result["rng_ledger"].size() == c[8], "case%d exact draw count" % i)
		if c[8] == 1:
			check(run["calls"] == ["boss_score"] and result["rng_ledger"][0]["source_line"] == 37693 				and result["rng_ledger"][0]["unit"] == c[6], "case%d single source RNG site" % i)
		check(move == before[0] and ps == before[1] and enemy == before[2], "case%d input dictionaries unchanged" % i)

func _test_gate_order_and_no_rng() -> void:
	var m: Dictionary = Catalog.move_by_id("burst")
	var cds: Array = []
	cds.resize(59)
	cds.fill(0)
	cds[0] = 5
	var e: Dictionary = {"_moveCDs": cds}
	for case in [[0, {"id": "cageTrap"}, 0, {}, "cageTrap", -1.0],
		[0, {"id": "burst", "phase": [1]}, 0, e, "phase", -1.0],
		[2, {"id": "burst", "phase": [0]}, 0, e, "moveset", -1.0],
		[0, m, 0, e, "cooldown", 0.0]]:
		var r: Dictionary = Utility.evaluate_move(case[0], case[1], 499.5, "unread invalid ps", case[2], case[3])
		check(r["status"] == "READY" and r["gate"] == case[4] and r["score"] == case[5] and r["rng_ledger"].is_empty(), "gate precedence without RNG/unused shape access")
	for cd in [null, [], [null], [0], [-1]]:
		var r: Dictionary = evaluate(0, m, 499.5, null, 0, {"_moveCDs": cd, "_lastMoves": []})["result"]
		check(r["status"] == "READY" and absf(r["score"] - 1.95) < 1e-12, "absent/empty/hole/nonpositive CD is not blocked")
	for phase in [-1, 5]:
		check(evaluate(0, m, 499.5, null, phase, {})["calls"].is_empty(), "out-of-phase gate consumes zero RNG")

func _test_history_counter_combo_boundaries() -> void:
	var m: Dictionary = Catalog.move_by_id("burst")
	var a: Dictionary = evaluate(0, m, 499.5, null, 0, {"_lastMoves": []})["result"]
	var b: Dictionary = evaluate(0, m, 499.5, null, 0, {"_lastMoves": ["burst"]})["result"]
	var missing: Dictionary = evaluate(0, m, 499.5, null, 0, {})["result"]
	check(absf(a["score"] - 1.95) < 1e-12 and absf(b["score"] - 1.09) < 1e-12, "independent supplied anchors 1.95/1.09")
	check(absf(missing["score"] - 1.6) < 1e-12, "missing history novelty0 differs from [] novelty.35")
	var repeated: Dictionary = evaluate(0, m, 499.5, null, 0, {"_lastMoves": ["burst", "burst", "burst", "burst"]})["result"]
	check(absf(repeated["terms"]["repeat_penalty"] - 0.70 * 0.45 * 0.28 * 0.15) < 1e-15, "every occurrence multiplied in oldest-to-newest order")
	check(absf(evaluate(0, m, 499.5, null, 0, {"_lastMoves": [], "_meleeStreak": 3})["result"]["score"] - 5.85) < 1e-12, "streak coefficient3 exact supplied anchor")
	var face: Dictionary = Catalog.move_by_id("charge")
	var si2: Dictionary = evaluate(2, face, 200, null, 0, {"_lastMoves": []}, 0.0)["result"]
	var si1: Dictionary = evaluate(1, face, 200, null, 0, {"_lastMoves": []}, 0.0)["result"]
	check(absf(si2["score"] - si1["score"] - 2.0) < 1e-12, "face+2 after RNG, not multiplied by .85")
	var close: Dictionary = Catalog.move_by_id("slashCombo")
	var r79: Dictionary = evaluate(0, close, 79.5, null, 0, {})["result"]
	var r80: Dictionary = evaluate(0, close, 80, null, 0, {})["result"]
	var r130: Dictionary = evaluate(0, close, 130, null, 0, {})["result"]
	check(r79["terms"]["counter_adjust"] == 1.4 and r80["terms"]["counter_adjust"] == 0.8 and r130["terms"]["counter_adjust"] == 0.0, "strict melee distance boundaries")
	var idx_negative: Dictionary = evaluate(0, m, 499.5, null, 0, {"_lastMoves": [], "_comboSeq": ["burst"], "_comboIdx": -1})["result"]
	check(idx_negative["terms"]["combo_bonus"] == 0.0, "negative array index does not wrap")

func _test_provider_failures() -> void:
	var m: Dictionary = Catalog.move_by_id("burst")
	check(Utility.evaluate_move(0, m, 499.5, null, 0, {})["status"] == "NOT_READY", "missing RNG is not default u.5")
	for u in [-1, 1, NAN, INF, null, true, "0.5"]:
		var run: Dictionary = evaluate(0, m, 499.5, null, 0, {}, u)
		check(run["result"]["status"] == "NOT_READY" and run["result"]["score"] == null and run["calls"].size() == 1, "invalid injected unit never yields score")
	for u in [0.0, 1.0 - 1.0 / 9007199254740992.0]:
		var run: Dictionary = evaluate(0, m, 499.5, null, 0, {"_lastMoves": []}, u)
		check(run["result"]["status"] == "READY" and absf(run["result"]["score"] - 1.95 * (0.85 + u * 0.3)) < 1e-12, "valid unit endpoints")
	for si in [-1, 4]:
		var run: Dictionary = evaluate(si, m, 499.5, null, 0, {})
		check(run["result"]["status"] == "NOT_READY" and run["calls"].is_empty(), "unowned chapter stage not unrestricted fallback")
	for enemy in [{"_lastMoves": "bad"}, {"_moveCDs": {}}, {"_moveCDs": ["1"]}, {"_comboSeq": "bad"}, {"_comboIdx": null}, {"_meleeStreak": "3"}]:
		var run: Dictionary = evaluate(0, m, 499.5, null, 0, enemy)
		check(run["result"]["status"] == "NOT_READY" and run["calls"].is_empty(), "unsupported source shape does not fabricate normal score")

func _test_bc02_and_readonly_scope() -> void:
	var before_children: int = root.get_child_count()
	var actions: Array[StringName] = InputMap.get_actions()
	var locale: String = TranslationServer.get_locale()
	var fps: int = Engine.max_fps
	var physics: int = Engine.physics_ticks_per_second
	var rng: Callable = func(_field: String) -> float: return 0.5
	var clear: Callable = func(_x: float, _y: float, _r: float) -> bool: return true
	var spawn: Dictionary = Spawn.build_spawn_packet({"si": 0, "x": 0, "y": 0, "room": 0,
		"player_level": 1, "difficulty_index": 5, "stage_diff_offset": 0}, rng, clear)
	check(spawn["status"] == "READY", "actual BC02 fields feed utility without actor")
	var fields: Dictionary = spawn["fields"]
	var saved: Dictionary = fields.duplicate(true)
	var move: Dictionary = Catalog.move_by_id("burst")
	var ps: Dictionary = {"parryRate": 0.0}
	var run: Dictionary = evaluate(0, move, 499.5, ps, 0, fields)
	check(absf(run["result"]["score"] - 2.16) < 1e-12, "BC02 engage+AOE initial-state source anchor")
	check(fields == saved and ps == {"parryRate": 0.0}, "no enemy or player-stat writer")
	run["result"]["terms"]["novelty"] = 99
	run["result"]["rng_ledger"][0]["unit"] = 0
	check(absf(evaluate(0, move, 499.5, ps, 0, fields)["result"]["score"] - 2.16) < 1e-12, "output mutation cannot change next call")
	var receipt: Dictionary = Utility.source_receipt()
	check(receipt["game_sha256"] == GAME_SHA256 and receipt["live_selection_connected"] == false, "source receipt and unconnected scope")
	receipt["face_moves"].clear()
	check(Utility.source_receipt()["face_moves"].size() == 6, "receipt deep copy")
	check(root.get_child_count() == before_children and InputMap.get_actions() == actions, "no nodes or input registration")

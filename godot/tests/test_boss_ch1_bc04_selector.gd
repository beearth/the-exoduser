var assertions: int = 0
var failures: int = 0
var source_path: String = ""
var scenario: String = "isolation"
var total_draws: int = 0

func _initialize() -> void:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--source-game="): source_path = arg.trim_prefix("--source-game=")
	call_deferred("_run")

func _run() -> void:
	var isolated: bool = ProjectSettings.get_setting("application/config/use_custom_user_dir", false) == true \
		and ProjectSettings.get_setting("application/config/custom_user_dir_name", "") == USERDIR \
		and OS.get_user_data_dir().get_file() == USERDIR
	check(isolated, "settings and actual OS userdir")
	if not isolated:
		finish(2)
		return
	check(not source_path.is_empty() and FileAccess.get_sha256(source_path) == GAME_SHA256, "latest main game hash")
	for raw: String in ORACLE_ROWS:
		var row: Dictionary = JSON.parse_string(raw)
		scenario = row["name"] + ":si" + str(row["si"]) + ":phase" + str(row["enemy"]["_bossPhase"])
		# JSON integers enter as floats; the source phase is an integer index.
		row["enemy"]["_bossPhase"] = int(row["enemy"]["_bossPhase"])
		var enemy: Dictionary = row["enemy"]
		var enemy_before: Dictionary = enemy.duplicate(true)
		var ps_before: Variant = row["ps"].duplicate(true) if row["ps"] is Dictionary else row["ps"]
		var calls: Array = []
		var rng: Callable = func(tag: String) -> Variant:
			var unit: Variant = row["units"][calls.size() % row["units"].size()]
			calls.append(tag)
			return unit
		var result: Dictionary = Selector.select_tick(int(row["si"]), enemy, row["sp"], row["d"], row["ps"], rng, row["debug"])
		check(result.get("status") == "READY", "oracle status: " + str(result.get("reason")))
		if result.get("status") != "READY": continue
		for field: String in ["enemy", "player_stats", "start_pattern", "rng_ledger"]:
			check(equivalent(result[field], row["expected"][field]), "source " + field)
		check(equivalent(enemy, enemy_before), "input enemy read-only")
		check(equivalent(row["ps"], ps_before), "input player stats read-only")
		check(calls.size() == result["rng_ledger"].size(), "actual callbacks match ledger")
		total_draws += calls.size()
	for raw: String in PICK_ROWS:
		var row: Dictionary = JSON.parse_string(raw)
		scenario = "weighted-" + row["pattern"]
		var calls: Array = []
		var result: Dictionary = Selector.pick_top_six(row["scores"], func(tag: String) -> Variant:
			calls.append(tag)
			return row["unit"])
		check(result["status"] == "READY", "weighted READY")
		check(result["ordinal"] == row["ordinal"], "stable ordinal/top6/floor exact source")
		check(calls.size() == row["draws"], "conditional roulette draws")
	_test_boundaries()
	finish(0 if failures == 0 else 1)

func equivalent(actual: Variant, expected: Variant) -> bool:
	if expected is Dictionary and expected.has("$nan"): return actual is float and is_nan(actual)
	if actual is Dictionary and expected is Dictionary:
		if actual.size() != expected.size(): return false
		for key in expected:
			if not actual.has(key) or not equivalent(actual[key], expected[key]): return false
		return true
	if actual is Array and expected is Array:
		if actual.size() != expected.size(): return false
		for i in range(expected.size()):
			if not equivalent(actual[i], expected[i]): return false
		return true
	if (actual is float or actual is int) and (expected is float or expected is int):
		if is_nan(actual) or is_nan(expected): return is_nan(actual) and is_nan(expected)
		return abs(float(actual) - float(expected)) <= 1e-12 * maxf(1.0, abs(float(expected)))
	return typeof(actual) == typeof(expected) and actual == expected

func base_enemy() -> Dictionary:
	var cds: Array = []
	cds.resize(59)
	cds.fill(0.0)
	return {"_bossPhase": 0, "stunned": 0.0, "s": "idle", "bossPatT": 0.0, "bossPatCd": 35.0,
		"_moveCDs": cds, "_comboSeq": null, "_comboIdx": 0, "_lastMoves": [], "_meleeStreak": 0}

func _test_boundaries() -> void:
	scenario = "provider-boundaries"
	var e: Dictionary = base_enemy()
	var no_rng: Dictionary = Selector.select_tick(0, e, 1.0, 100.0, null)
	check(no_rng["status"] == "NOT_READY" and no_rng["enemy"] == null, "missing RNG produces no state")
	for value in [-0.1, 1.0, INF, NAN, "invalid", null]:
		var calls: Array = []
		var result: Dictionary = Selector.select_tick(0, e, 1.0, 100.0, null, func(tag: String) -> Variant:
			calls.append(tag)
			return value)
		check(result["status"] == "NOT_READY" and result["enemy"] == null, "bad RNG has no applicable state")
		check(calls.size() == 1 and result["rng_ledger"].size() == 1, "bad RNG stops at first attempt")
	# A late provider failure cannot pretend earlier draws were rolled back.
	var late: Array = []
	var result: Dictionary = Selector.select_tick(0, e, 1.0, 100.0, null, func(tag: String) -> Variant:
		late.append(tag)
		return 1.0 if tag == "combo_gate" else 0.5)
	check(result["status"] == "NOT_READY" and result["enemy"] == null, "late failure withheld")
	check(result["rng_ledger"].size() == late.size() and late.back() == "combo_gate", "late consumed draws preserved")
	for bad_si in [-1, 4, 34]:
		check(Selector.select_tick(bad_si, e, 1, 100, null)["status"] == "NOT_READY", "unsupported stage")
	for bad in [{"_bossPhase": 5}, {"_bossPhase": 0.5}, {"_moveCDs": {}}, {"_lastMoves": 1}, {"_comboSeq": 1}, {"_comboIdx": "x"}, {"_meleeStreak": "x"}]:
		var broken: Dictionary = e.duplicate(true)
		broken.merge(bad, true)
		check(Selector.select_tick(0, broken, 1, 100, null)["status"] == "NOT_READY", "unsupported snapshot shape")
	check(Selector.select_tick(0, e, INF, 100, null)["status"] == "NOT_READY", "infinite clock")
	check(Selector.select_tick(0, e, 1, NAN, null)["status"] == "NOT_READY", "NaN distance")
	# Numeric unit endpoint is computed, avoiding rounded decimal source literals.
	var scores: Array = []
	scores.resize(59)
	scores.fill(-1)
	for i in range(8): scores[i] = 1.0
	result = Selector.pick_top_six(scores, func(_tag: String) -> float: return 1.0 - 1.0 / 9007199254740992.0)
	check(result["status"] == "READY" and result["ordinal"] == 5, "max legal unit selects sixth tied ordinal")
	check(Selector.pick_top_six([])["status"] == "NOT_READY", "not a source 59-slot table")
	# Explicit BC04 acceptance anchors, independent of the generated oracle rows.
	scenario = "acceptance-and-BC02"
	e = base_enemy()
	e["_comboSeq"] = ["charge"]
	e["_lastMoves"] = ["a", "b", "c", "d", "e"]
	result = Selector.select_tick(0, e, 1, 100, null, func(_tag: String) -> float: return 0.0)
	check(result["enemy"]["bossPatT"] == 6, "combo timer u0=6")
	check(result["enemy"]["_moveCDs"][2] == 50, "source cd100 times phase0 .5")
	check(result["enemy"]["_lastMoves"] == ["b", "c", "d", "e", "charge"], "history5")
	check(result["start_pattern"]["extra_delay"] == 20 and result["enemy"]["_feinting"], "charge conditional feint and delay")
	check(result["rng_ledger"].size() == 3, "combo has timer/feint/delay only")
	var spawn: Dictionary = Spawn.build_spawn_packet({"si": 0, "room": 0, "player_level": 1, "stage_diff_offset": 0, "difficulty_index": 0, "x": 100.0, "y": 100.0},
		func(_field: String) -> float: return 0.5, func(_x: float, _y: float, _r: float) -> bool: return true)
	check(Selector.source_receipt()["live_selection_connected"] == false, "no product AI connection claimed")
	check(spawn["status"] == "READY", "BC02 packet ready")
	if spawn["status"] == "READY":
		var actor: Dictionary = spawn["fields"].duplicate(true)
		actor["bossPatT"] = 0
		var actor_before: Dictionary = actor.duplicate(true)
		result = Selector.select_tick(0, actor, 1, 100, null, func(_tag: String) -> float: return 0.5)
		check(result["status"] == "READY" and result["start_pattern"] != null, "real BC02 snapshot selects")
		check(equivalent(actor, actor_before), "real BC02 snapshot read-only")

func check(ok: bool, message: String) -> void:
	assertions += 1
	if not ok:
		failures += 1
		printerr("BC04_FAIL ", scenario, " ", message)

func finish(code: int) -> void:
	print("BC04_RESULT ", JSON.stringify({"assertions": assertions, "failures": failures, "skipped": [],
		"source_cases": ORACLE_ROWS.size(), "weighted_cases": PICK_ROWS.size(), "source_rng_draws": total_draws,
		"public_play_evidence": false, "userdir": OS.get_user_data_dir()}))
	quit(code)

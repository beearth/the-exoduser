var source_draws: int=0
var source_contacts: int=0
var source_path: String=""
func _initialize() -> void:
	for arg: String in OS.get_cmdline_user_args():
		if arg.begins_with("--source-game="): source_path=arg.trim_prefix("--source-game=")
	call_deferred("_run")
func _run() -> void:
	var isolated: bool=ProjectSettings.get_setting("application/config/use_custom_user_dir",false)==true and ProjectSettings.get_setting("application/config/custom_user_dir_name","")==USERDIR and OS.get_user_data_dir().get_file()==USERDIR
	check(isolated,"exact custom settings and actual OS userdir")
	if not isolated:
		finish(2)
		return
	check(not source_path.is_empty() and FileAccess.get_sha256(source_path)==GAME_SHA256,"latest main source hash")
	for raw: String in ORACLE_ROWS:
		var row: Dictionary=JSON.parse_string(raw)
		original_integer_paths=row["integer_paths"]
		scenario=row["name"]+":"+row["enemy"]["s"]+":si"+str(row["si"])+":t"+str(row["enemy"]["st2"])
		var result: Dictionary=consume(row)
		check(result["status"]=="READY" and result.get("done",false),"READY/done: "+str(result.get("reason")))
		if result["status"]!="READY": continue
		if row["name"]=="idle-stun-return": check(result["next_boundary"]=="AI_then_feint_then_actual_state_switch","stunned return skips in-function idle projectiles")
		check(equivalent(result["enemy"],row["expected"]["enemy"],"/enemy"),"all actor fields")
		check(equivalent(result["player"],row["expected"]["player"],"/player"),"player owner readback preserved")
		check(equivalent(result["all_events"],row["expected"]["events"],"/events"),"source writes/requests/RNG exact order and sites")
		check(equivalent(result["globals"],row["expected"]["globals"],"/globals"),"authored global writes only")
		check(result["cursor"]==row["expected"]["cursor"],"nested owner fixture RNG interleaving")
		check(result["contacts"]==row["responses"].size(),"request count, not actual damage/parry")
		source_events+=result["all_events"].size()
		source_contacts+=result["contacts"]
		for event: Dictionary in result["all_events"]:
			if event["kind"]=="rng": source_draws+=1
	_test_failures()
	_test_upstream_scope()
	_test_oracle_anchors()
	finish(0 if failures==0 else 1)
func consume(row: Dictionary) -> Dictionary:
	var before: Dictionary=row.duplicate(true)
	var started: Dictionary=Move.begin_tick(int(row["si"]),row["checkpoint"],row["enemy"],row["sp"],row["player"],row["context"])
	check(started["status"]=="READY","begin source snapshot")
	if started["status"]!="READY": return started
	var token: Dictionary=started["continuation"]
	var response: Variant=null
	var events: Array=[]
	var cursor: Array=[0]
	var contacts: int=0
	var collision: int=0
	var globals: Dictionary={"shake":71,"_flashT":99,"_flashCol":"keep"}
	var result: Dictionary={}
	for guard in range(40):
		var token_before: Dictionary=token.duplicate(true)
		result=Move.next_tick(token,response,func(_tag: String) -> Variant:
			var u: Variant=row["units"][cursor[0]%row["units"].size()]
			cursor[0]+=1
			return u)
		check(token==token_before,"continuation read-only")
		if result["status"]!="READY": return result
		check(result["full_tick_complete"]==false,"no full tick/combat claim")
		events.append_array(result["events"])
		for event: Dictionary in result["events"]:
			if event["kind"]=="global_write": globals[event["field"]]=event["value"]
		if result["done"]: break
		var command: Dictionary=result["command"]
		check(command["executed"]==false,"unexecuted request")
		response={"ack":true}
		match command["command"]:
			"canMv":
				response["value"]=row["collision"][collision%row["collision"].size()]
				collision+=1
			"_ffDir": response["value"]=row["flow"]
			"_T": response["value"]="translated:"+command["args"][0]
			"resolve_boss_movement_contact":
				check(contacts<row["responses"].size(),"source owner readback exists")
				if contacts>=row["responses"].size(): return {"status":"NOT_READY","reason":"fixture_missing"}
				var authority: Dictionary=row["responses"][contacts]
				response["enemy_after"]=authority["enemy_after"]
				response["player_after"]=authority["player_after"]
				cursor[0]=int(authority["cursor_after"])
				contacts+=1
			_: cursor[0]+=int(row["nested"])
		token=result["continuation"]
	check(row==before,"all source inputs read-only")
	result["all_events"]=events
	result["globals"]=globals
	result["cursor"]=cursor[0]
	result["contacts"]=contacts
	return result
func equivalent(a: Variant,b: Variant,path: String="") -> bool:
	if a is Dictionary and b is Dictionary:
		if a.size()!=b.size(): return false
		for key in b:
			if not a.has(key) or not equivalent(a[key],b[key],path+"/"+str(key)): return false
		return true
	if a is Array and b is Array:
		if a.size()!=b.size(): return false
		for i in range(b.size()):
			if not equivalent(a[i],b[i],path+"/"+str(i)): return false
		return true
	if (a is int or a is float) and (b is int or b is float):
		if original_integer_paths.has(path): return a==b
		return abs(float(a)-float(b))<=1e-12*maxf(1.0,abs(float(b)))
	return typeof(a)==typeof(b) and a==b
func actor(state: String="bossCharge") -> Dictionary:
	return {"ib":true,"alive":true,"etype":0,"s":state,"x":0,"y":0,"r":44,"st2":5,"facing":0,"atk":46,"el":0,"col":"#bbbbbb","echDx":1,"echDy":0,"stunned":0,"speed":0.5,"_bossPhase":0,"projCd":50,"projT":0}
func player() -> Dictionary: return {"x":100,"y":0,"r":12,"iframes":0,"s":"idle"}
func _test_failures() -> void:
	scenario="missing/invalid owner readers"
	var e: Dictionary=actor()
	check(Move.begin_tick(4,"state",e,1,player())["status"]=="NOT_READY","no chapter2")
	var bad: Dictionary=e.duplicate(true)
	bad["ib"]=false
	check(Move.begin_tick(0,"state",bad,1,player())["status"]=="NOT_READY","no ordinary enemy impersonation")
	bad["ib"]=true
	bad["s"]="eCharge"
	check(Move.begin_tick(0,"state",bad,1,player())["status"]=="NOT_READY","no generic eCharge reuse")
	check(Move.begin_tick(0,"idle_move",actor("idle"),1,player())["status"]=="NOT_READY","requires cached d")
	var t: Dictionary=Move.begin_tick(0,"state",e,1,player())["continuation"]
	check(Move.next_tick(t)["status"]=="NOT_READY","trail globals not assumed")
	t=Move.begin_tick(0,"state",e,1,player(),{"frame":7,"vfx_available":true})["continuation"]
	var pending: Dictionary=Move.next_tick(t)
	check(pending["command"]["command"]=="canMv","collision is first owner")
	check(Move.next_tick(pending["continuation"])["status"]=="NOT_READY","actual ack required")
	check(Move.next_tick(pending["continuation"],{"ack":true})["status"]=="NOT_READY","collision bool required")
	pending=Move.next_tick(pending["continuation"],{"ack":true,"value":true})
	check(pending["command"]["command"]=="resolve_boss_movement_contact","charge contact stops at owner")
	var refused: Dictionary=Move.next_tick(pending["continuation"],{"ack":true})
	check(refused["status"]=="NOT_READY" and refused["enemy"]==null and refused["player"]==null,"no fake protected success")
	refused=Move.next_tick(pending["continuation"],{"ack":true,"enemy_after":{},"player_after":{}})
	check(refused["status"]=="NOT_READY","complete snapshots required")
	var incomplete: Dictionary=e.duplicate(true)
	incomplete.erase("echDx")
	refused=Move.next_tick(pending["continuation"],{"ack":true,"enemy_after":incomplete,"player_after":player()})
	check(refused["status"]=="NOT_READY","minimum actor shape cannot drop existing direction/other fields")
	var p_extra: Dictionary=player()
	p_extra["owner_preserved"]=91
	var with_extra: Dictionary=Move.begin_tick(0,"state",e,1,p_extra,{"frame":7,"vfx_available":true})
	var move_request: Dictionary=Move.next_tick(with_extra["continuation"])
	var contact_request: Dictionary=Move.next_tick(move_request["continuation"],{"ack":true,"value":true})
	refused=Move.next_tick(contact_request["continuation"],{"ack":true,"enemy_after":e,"player_after":player()})
	check(refused["status"]=="NOT_READY","player owner field omission is not complete readback")
	t=Move.begin_tick(0,"idle_move",actor("idle"),1,player(),{"distance":300})["continuation"]
	pending=Move.next_tick(t)
	check(pending["command"]["command"]=="_ffDir","flow provider boundary")
	check(Move.next_tick(pending["continuation"],{"ack":true})["status"]=="NOT_READY","missing flow distinct from null")
	check(Move.next_tick(pending["continuation"],{"ack":true,"value":{"x":1}})["status"]=="NOT_READY","incomplete flow rejected")
	t=Move.begin_tick(0,"state",actor("bossMultiDashWind"),1,player())["continuation"]
	check(Move.next_tick(t)["status"]=="NOT_READY","missing RNG does not manufacture unit")
	for u: Variant in [-0.1,1.0,NAN,"0.5"]:
		refused=Move.next_tick(t,null,func(_tag: String) -> Variant: return u)
		check(refused["status"]=="NOT_READY" and refused["rng_ledger"].size()==1,"invalid consumed unit receipt retained")
func _test_upstream_scope() -> void:
	scenario="BC02-05-06 data contracts"
	var actions: Array[StringName]=InputMap.get_actions()
	var children: int=root.get_child_count()
	var fps: int=Engine.max_fps
	var locale: String=TranslationServer.get_locale()
	var spawn: Dictionary=Spawn.build_spawn_packet({"si":0,"room":0,"player_level":1,"stage_diff_offset":0,"difficulty_index":0,"x":0,"y":0},func(_tag: String) -> float: return 0.5,func(_x: float,_y: float,_r: float) -> bool: return true)
	check(spawn["status"]=="READY","BC02 numeric packet")
	for phase in [0,4]:
		var started: Dictionary=Start.begin_start(0,"multiDash",spawn["fields"],1500,phase)
		var token: Dictionary=started["continuation"]
		var response: Variant=null
		var e: Dictionary={}
		for guard in range(8):
			var next: Dictionary=Start.next_start(token,response)
			check(next["status"]=="READY","BC06 actual source start packet")
			if next["status"]!="READY": return
			e=next["enemy"]
			if next["done"]: break
			token=next["continuation"]
			response={"ack":true}
		check(e["_dashCnt"]==(4 if phase==0 else 10) and e["s"]=="bossMultiDashWind","actual count4/10, no guessed formula")
		var clock: Dictionary=Phase.clock_step(0,"after_projectile_charge",e,1,{"flow_direction":null,"player_x":100,"player_y":0})
		started=Move.begin_tick(0,"state",clock["enemy"],1,player())
		var next: Dictionary=Move.next_tick(started["continuation"],null,func(_tag: String) -> float: return 0.5)
		check(next["status"]=="READY" and next["done"] and next["enemy"]["st2"]==clock["enemy"]["st2"],"no duplicate state timer decrement")
		check(next["enemy"]["poise"]==e["poise"] and next["enemy"]["reviveIframes"]==e["reviveIframes"],"protected fields unchanged without contact owner")
	check(not Move.source_receipt()["live_combat_connected"] and not Move.source_receipt()["damage_or_parry_execution_verified"],"no combat/QE claim")
	check(InputMap.get_actions()==actions and root.get_child_count()==children,"no input/scene mutation")
	check(Engine.max_fps==fps and TranslationServer.get_locale()==locale,"global settings preserved")
func _test_oracle_anchors() -> void:
	scenario="source independent chains"
	var phase4_count: int=0
	var landing: int=0
	var charge_recover: int=0
	for raw: String in ORACLE_ROWS:
		var row: Dictionary=JSON.parse_string(raw)
		if row["name"]=="dash-chain" and row["enemy"]["_bossPhase"]==4: phase4_count+=1
		if row["name"]=="jump-once-native-clock" and row["expected"]["enemy"]["s"]=="bossShock": landing+=1
		if row["name"]=="charge-50-native-clock" and row["expected"]["enemy"]["s"]=="recover": charge_recover+=1
	check(phase4_count==10,"source phase4 ten dash completions")
	check(landing==3,"one landing per .5/1/2 clock chain")
	check(charge_recover==3,"source charge ends after50 native frames for .5/1/2")
func check(ok: bool,message: String) -> void:
	assertions+=1
	if not ok:
		failures+=1
		printerr("BC08_FAIL ",scenario," ",message)
func finish(code: int) -> void:
	print("BC08_RESULT ",JSON.stringify({"assertions":assertions,"failures":failures,"skipped":[],"source_cases":ORACLE_ROWS.size(),"source_events":source_events,"source_rng_draws":source_draws,"protected_contact_requests":source_contacts,"damage_or_parry_evidence":false,"userdir":OS.get_user_data_dir()}))
	quit(code)

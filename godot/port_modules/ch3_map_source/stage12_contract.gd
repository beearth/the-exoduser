static func same(value: Variant,expected: Variant) -> bool:
 # si12 has an absent dungeon spec represented as null plus its explicit mask.
 # Keep existing shared helpers untouched; they reject null scalar carriers.
 if expected==null:return value==null
 if expected is Dictionary:
  if not value is Dictionary or value.size()!=expected.size():return false
  for key in expected:
   if not value.has(key) or not same(value[key],expected[key]):return false
  return true
 if expected is Array:
  if not value is Array or value.size()!=expected.size():return false
  for i in expected.size():
   if not same(value[i],expected[i]):return false
  return true
 return CH1.literal(value,expected)

static func read_area(raw: Variant) -> Dictionary:
 return validate_area(raw)

static func validate_area(raw: Variant) -> Dictionary:
 var reason:=error(raw)
 if not reason.is_empty():return {"status":"NOT_READY","reason":reason,"raw":raw,"scope":"source_snapshot_only"}
 return {"status":"READY","value":raw,"scope":"source_snapshot_only","source_only_stage":12,
  "runtime_bound":false,"full_stage_ready":false,"visual_verified":false,
  "provenance_validation":"declared source pins; no source file reads"}

static func error(raw: Variant) -> String:
 if not raw is Dictionary:return "snapshot_not_dictionary"
 if raw.size()!=ROOT_KEYS.size():return "source_root_shape_mismatch"
 for key in ROOT_KEYS:
  if not raw.has(key):return "missing_source_field:"+key
 if not CH1.literal(raw.schema,SCHEMA) or not CH1.literal(raw.stage,12):return "unsupported_schema_or_stage"
 if not same(raw.grid,{"width":200,"height":200,"tile_size":40}):return "grid_mismatch"
 var source: Variant=raw.source
 if not source is Dictionary or source.size()!=6 or not CH1.hex(source.get("main_sha"),40) \
   or not CH1.hex(source.get("extraction_head"),40) or not CH1.literal(source.get("game_sha256"),GAME_SHA):return "source_provenance_missing"
 if not CH1.literal(source.get("selection"),"default empty URL → _getFixedMapForStage(12) → _cloneField11(12) → genFromTemplate"):return "source_selection_mismatch"
 if not same(source.get("files"),FILES) or not same(source.get("symbols"),SYMBOLS):return "source_records_mismatch"
 for pair in [["hand_props_raw",HANDS],["initial_obj_meta",META],["ch3_deco_raw",DECO],["cross_deco_raw",[]],
   ["asset_refs",ASSETS],["ground_asset",GROUND],["rooms",ROOMS],["chapter_stages",CHAPTERS],
   ["region_details",REGIONS],["source_floor",FLOOR],["compose_raw",COMPOSE],["selector_evidence",SELECTOR],
   ["stage_descriptor",STAGE],["guard_evidence",GUARD],["environment_refs",ENV],["scope",SCOPE],["undefined_paths",UNDEFINED],["pipeline",PIPELINE]]:
  if not same(raw[pair[0]],pair[1]):return "source_field_mismatch:"+pair[0]
 if not CH1.numbers(raw.start_tile,[100,185]) or not CH1.numbers(raw.start_world,[4020,7420]) \
   or not CH1.numbers(raw.exit_center_tile,[100,7]):return "start_or_exit_center_mismatch"
 for key in ["boss_gate","exits"]:
  var entries: Variant=raw[key]
  if not entries is Array or entries.size()!=3:return "gate_or_exit_missing"
  for i in 3:
   if not same(entries[i],{"x":99+i,"y":5 if key=="boss_gate" else 7}):return "gate_or_exit_mismatch"
 var tiles: Variant=raw.tiles
 if not tiles is Array or tiles.size()!=40000:return "runtime_tiles_incomplete"
 var bytes:=PackedByteArray();bytes.resize(40000)
 var counts: Array=[0,0,0,0,0]
 for i in 40000:
  if not CH1.integer(tiles[i]) or tiles[i]<0 or tiles[i]>4:return "runtime_tile_invalid"
  bytes[i]=int(tiles[i]);counts[int(tiles[i])]+=1
 if counts!=[38986,36,3,0,975] or not CH1.literal(raw.runtime_tile_sha256,TILE_SHA) \
   or CH1.digest(bytes)!=TILE_SHA:return "runtime_tile_hash_or_counts_mismatch"
 var generation: Variant=raw.generation
 if not generation is Dictionary or generation.size()!=5 or not CH1.integer(generation.get("seed")) \
   or generation.seed<0 or generation.seed>4294967295 or not CH1.literal(generation.get("random_draws"),14) \
   or not CH1.literal(generation.get("random_algorithm"),"LCG uint32: imul(1664525)+1013904223; /4294967296") \
   or not CH1.literal(generation.get("timer_basis"),"seeded source VM observation only; not browser boot RNG"):return "seed_evidence_missing"
 var state:=int(generation.seed)
 var holes: Variant=raw.spawn_holes_final
 if not holes is Array or holes.size()!=14 or not CH1.literal(raw.total_spawned,1100):return "hole_totals_mismatch"
 var totals: Array=[0,0,0,0]
 for i in 14:
  var h: Variant=holes[i]
  if not h is Dictionary or h.size()!=7:return "source_hole_shape_mismatch"
  if not CH1.numbers([h.get("x"),h.get("y"),h.get("size"),h.get("room"),h.get("count")],HOLES[i]) \
    or not CH1.literal(h.get("alive"),0) or not CH1.number(h.get("timer")):return "ordered_source_hole_mismatch"
  state=(state*1664525+1013904223)&0xffffffff
  if absf(float(h.timer)-(600.0+float(state)/4294967296.0*60.0))>0.00000001:return "source_timer_mismatch"
  var quadrant: int=(0 if h.y<4000 else 2)+(0 if h.x<4000 else 1)
  totals[quadrant]+=int(h.count)
 if not CH1.integer(generation.get("random_final_state")) or generation.random_final_state!=state:return "seed_final_state_mismatch"
 if not CH1.numbers(raw.region_totals,[250,300,350,200]) or not CH1.numbers(raw.region_totals,totals):return "region_sum_mismatch"
 return ""

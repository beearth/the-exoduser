static func same(value: Variant, expected: Variant) -> bool:
 if expected is Dictionary:
  if not value is Dictionary or value.size()!=expected.size():return false
  for key in expected:
   if not value.has(key) or not same(value[key],expected[key]):return false
  return true
 if expected is Array:
  if not value is Array or value.size()!=expected.size():return false
  for i in expected.size():
   if not same(value[i],expected[i]):return false
  return true
 return CH1.literal(value,expected)

static func read_area(raw: Variant) -> Dictionary:
 return validate_area(raw)

static func validate_area(raw: Variant) -> Dictionary:
 var reason:=error(raw)
 if not reason.is_empty():
  return {"status":"NOT_READY","reason":reason,"raw":raw,"scope":"source_snapshot_only"}
 return {"status":"READY","value":raw,"scope":"source_snapshot_only","source_only_stage":4,
  "runtime_bound":false,"full_stage_ready":false,"visual_verified":false,
  "provenance_validation":"declared source pins; no source file reads"}

static func error(raw: Variant) -> String:
 if not raw is Dictionary:return "snapshot_not_dictionary"
 if not CH1.literal(raw.get("schema"),SCHEMA) or not CH1.integer(raw.get("stage")) or raw.stage!=4:return "unsupported_schema_or_stage"
 if not same(raw.get("grid"),{"width":200,"height":200,"tile_size":40}):return "grid_mismatch"
 var source: Variant=raw.get("source")
 if not source is Dictionary or not CH1.hex(source.get("main_sha"),40) or not CH1.hex(source.get("extraction_head"),40) \
   or not CH1.literal(source.get("game_sha256"),GAME_SHA):return "source_provenance_missing"
 if not CH1.literal(source.get("selection"),"default empty URL → _getFixedMapForStage(4) → _cloneField11(4) → genFromTemplate"):return "source_selection_mismatch"
 if not same(source.get("files"),FILES) or not same(source.get("symbols"),SYMBOLS):return "source_records_mismatch"
 if raw.has("ch1_deco_raw") or raw.has("source_geometry"):return "foreign_ch1_data"
 if not same(raw.get("initial_obj_meta"),META) or not same(raw.get("ch2_deco_raw"),DECO):return "raw_catalog_mismatch"
 if not same(raw.get("hand_props_raw"),HANDS):return "ordered_raw_hand_mismatch"
 if not same(raw.get("source_path"),PATH):return "source_path_or_rle_mismatch"
 if not same(raw.get("asset_refs"),ASSETS):return "asset_references_mismatch"
 if not same(raw.get("chapter_stages"),CHAPTERS) or not same(raw.get("rooms"),ROOMS):return "chapter_or_rooms_mismatch"
 if not CH1.numbers(raw.get("start_tile"),[100,185]) or not CH1.numbers(raw.get("start_world"),[4020,7420]) \
   or not CH1.numbers(raw.get("exit_center_tile"),[100,33]):return "start_or_exit_center_mismatch"
 for key in ["boss_gate","exits"]:
  var entries: Variant=raw.get(key)
  if not entries is Array or entries.size()!=3:return "gate_or_exit_missing"
  for i in 3:
   if not same(entries[i],{"x":99+i,"y":31 if key=="boss_gate" else 33}):return "gate_or_exit_mismatch"
 var tiles: Variant=raw.get("tiles")
 if not tiles is Array or tiles.size()!=40000:return "runtime_tiles_incomplete"
 var bytes:=PackedByteArray()
 bytes.resize(40000)
 var counts: Array=[0,0,0,0,0]
 for i in 40000:

{
 "headers": [
  {
   "source": "/(.*)",
   "headers": [
    {
     "key": "X-Robots-Tag",
     "value": "noindex, nofollow"
    }
   ]
  },
  {
   "source": "/Build/(.+)\\.data\\.br",
   "headers": [
    {
     "key": "Content-Encoding",
     "value": "br"
    },
    {
     "key": "Content-Type",
     "value": "application/octet-stream"
    }
   ]
  },
  {
   "source": "/Build/(.+)\\.wasm\\.br",
   "headers": [
    {
     "key": "Content-Encoding",
     "value": "br"
    },
    {
     "key": "Content-Type",
     "value": "application/wasm"
    }
   ]
  },
  {
   "source": "/Build/(.+)\\.js\\.br",
   "headers": [
    {
     "key": "Content-Encoding",
     "value": "br"
    },
    {
     "key": "Content-Type",
     "value": "application/javascript"
    }
   ]
  }
 ]
}
 "petLines": [
  {
   "id": "dd_first",
   "crow": "…죽었군. 하지만 여신은 아직 널 안 놓았어.",
   "cat": "괜찮아?! 다시 일어설 수 있어, 포기하지 마!"
  },
  {
   "id": "dd_boss_lowhp",
   "crow": "…한 끗이었어. 아까워 말고 다시 해.",
   "cat": "아아! 조금만 더였는데!! 다음엔 진짜 잡자!"
  },
  {
   "id": "dd_boss",
   "crow": "보스는 원래 이렇게 죽이는 거다. 여러 번.",
   "cat": "저 녀석 패턴 봤지?! 다음엔 안 당해!"
  },
  {
   "id": "dd_rare",
   "crow": "…이름값 하는 놈이었군.",
   "cat": "레어몹한테?! 센 만큼 좋은 걸 떨군다니까!"
  },
  {
   "id": "dd_trash",
   "crow": "잡졸한테 죽다니. …방심했군.",
   "cat": "저런 애들한테?! 정신 좀 차려어!"
  },
  {
   "id": "dd_dot",
   "crow": "…발밑을 봐. 서 있던 자리가 널 죽였어.",
   "cat": "장판 위에 서 있었잖아! 빨리 빠졌어야지!"
  },
  {
   "id": "dd_proj",
   "crow": "탄을 못 읽었어. 눈을 크게 떠.",
   "cat": "날아오는 거 봤어야지! 패링이든 회피든!"
  },
  {
   "id": "dd_grab",
   "crow": "잡히면 끝이야. 거리를 배워.",
   "cat": "붙잡혔어! 다음엔 옆으로 굴러!"
  },
  {
   "id": "dd_chapter_repeat",
   "crow": "…이 챕터가 네 무덤이 되고 있다.",
   "cat": "여기서 또?! 이 구간 진짜 조심해!"
  },
  {
   "id": "dd_repeat10",
   "crow": "열 번. …죽는 것도 재능이군.",
   "cat": "또?! 우리 진짜 같이 좀 살자아!"
  },
  {
   "id": "dd_repeat5",
   "crow": "…또야. 같은 실수는 그만.",
   "cat": "다섯 번째야! 패턴 좀 외워줘!"
  },
  {
   "id": "dd_highcombo",
   "crow": "잘 나가다 한 방에. …끝까지 방심 마.",
   "cat": "그렇게 잘하다가!! 아까워 죽겠어!"
  },
  {
   "id": "dd_corpse",
   "crow": "…지옥에 망자 하나 더 늘릴 셈이야?",
   "cat": "그런 소리 마! 얜 아직 안 죽었어! 일어나!"
  },
  {
   "id": "dd_queen",
   "crow": "…여왕님이 실망하시겠군.",
   "cat": "실망은 무슨! 다시 일어나면 되잖아, 얼른!"
  },
  {
   "id": "dd_sleep",
   "crow": "잠은 집에 가서 자. …일어나.",
   "cat": "여기서 자면 진짜 집 못 가! 얼른 일어나!"
  },
  {
   "id": "dd_purpose",
   "crow": "여기서 포기하면… 누가 가족의 원수를 갚지?",
   "cat": "우리가 있잖아! 다시 일어나 끝까지 가!"
  },
  {
   "id": "dd_purpose2",
   "crow": "네가 멈추면, 가족을 위해 싸울 자는 없어.",
   "cat": "너밖에 없어! 여기서 주저앉지 마!"
  },
  {
   "id": "dd_purpose3",
   "crow": "…복수는 살아남은 자만이 한다.",
   "cat": "죽은 채로는 아무것도 못 갚아! 일어나!"
  },
  {
   "id": "dd_purpose4",
   "crow": "가족의 얼굴을 떠올려. 그게 네가 일어날 이유야.",
   "cat": "잊지 마! 우리가 왜 여기 있는지!"
  },
  {
   "id": "dd_habit",
   "crow": "포기하는 건… 결국 습관이 돼.",
   "cat": "한 번 포기하면 계속 포기하게 돼! 여기서 끊어!"
  },
  {
   "id": "dd_vengeance",
   "crow": "일어나. 복수만이 정의다.",
   "cat": "맞아! 여기서 끝낼 순 없어! 일어나!"
  },
  {
   "id": "dd_ch0",
   "crow": "썩은 숲이 첫 무덤이라니. 일어나.",
   "cat": "아직 시작인데! 다시 가자!"
  },
  {
   "id": "dd_ch1",
   "crow": "벌레 밥이 될 뻔했군.",
   "cat": "으으 여기서 죽기 싫어! 다시!"
  },
  {
   "id": "dd_ch2",
   "crow": "얼어붙기 전에 일어나.",
   "cat": "추운 데서 쓰러지지 마! 얼른!"
  },
  {
   "id": "dd_ch3",
   "crow": "잿더미가 되기 전에.",
   "cat": "뜨거운 데서 눕지 좀 마아!"
  },
  {
   "id": "dd_ch4",
   "crow": "수에 삼켜졌군. 다시.",
   "cat": "너무 많았어! 이번엔 뭉칠 때 노리자!"
  },
  {
   "id": "dd_ch5",
   "crow": "사도들이 널 비웃고 있어.",
   "cat": "여기 진짜 까다로워! 정신 바짝!"
  },
  {
   "id": "dd_ch6",
   "crow": "지옥성이 널 붙잡았어. 놓지 않게 해.",
   "cat": "최종장이야! 여기서 무너지면 안 돼!"
  }
 ],

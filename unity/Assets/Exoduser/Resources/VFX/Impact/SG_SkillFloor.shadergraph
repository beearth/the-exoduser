{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "0f243cb4faa649d6a0a6f80030898031",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "SkillFloorFilm (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -900.0,
            "y": 120.0,
            "width": 200.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "d4eacac95317462491f2150b2fb68af3"
        },
        {
            "m_Id": "95c5eac3470745be81b3dddb3284dd32"
        },
        {
            "m_Id": "f7c8c042b4c345538ba713d74a1c6ece"
        },
        {
            "m_Id": "42a592bea2f44bb9927aaf56f0780594"
        },
        {
            "m_Id": "a997db1efd73467ea322595476e1396c"
        },
        {
            "m_Id": "ef464340fa464e64a9cff7d4a1203f73"
        },
        {
            "m_Id": "7625af5d374b4175ac2b4e62d469c9bf"
        },
        {
            "m_Id": "97f416cdd2854a7bacb76350bff30495"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "SkillFloorFilm",
    "m_FunctionSource": "",
    "m_FunctionBody": "\nfloat2 p = (UV-0.5)*2.0;\nfloat r = length(p);\nfloat grain = saturate(0.5 + 0.3*sin(p.x*23.0+sin(p.y*31.0)) + 0.2*sin(p.y*47.0));\nfloat inside = 1.0-smoothstep(0.96,1.0,r);\nfloat rim = (1.0-smoothstep(0.012,0.04,abs(r-0.975)))*smoothstep(0.25,0.6,grain);\nColor = lerp(FillColor,EdgeColor,rim);\nEmission = EdgeColor*rim*EdgeGlow;\nAlpha = saturate((inside*grain*0.2+rim*0.35)*Fade);\n"
}


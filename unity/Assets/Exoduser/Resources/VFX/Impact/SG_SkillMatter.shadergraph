{
    "m_SGVersion": 1,
    "m_Type": "UnityEditor.ShaderGraph.CustomFunctionNode",
    "m_ObjectId": "c226ccbac15e4e67afcc65e1cca58240",
    "m_Group": {
        "m_Id": ""
    },
    "m_Name": "RoughMaterial (Custom Function)",
    "m_DrawState": {
        "m_Expanded": true,
        "m_Position": {
            "serializedVersion": "2",
            "x": -900.0,
            "y": 120.0,
            "width": 200.0,
            "height": 120.0
        }
    },
    "m_Slots": [
        {
            "m_Id": "297b854412c0404094dba5726a12c9f2"
        },
        {
            "m_Id": "dce9ea0280b14c68bdce11d2d828c246"
        },
        {
            "m_Id": "04f176c7615b48f9a3cf44d066f8d953"
        },
        {
            "m_Id": "c23ecf796d0448d5bb00ab17ac7b2873"
        },
        {
            "m_Id": "4a23edf51a264f54a8fd4202e142ab45"
        },
        {
            "m_Id": "8fbf94a44d2b47f7b029dd4c4189c9f1"
        },
        {
            "m_Id": "d8c023bfd7d9405799251edfbc7d8650"
        },
        {
            "m_Id": "73fa7006c6024d1eb97df407e926a524"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "RoughMaterial",
    "m_FunctionSource": "",
    "m_FunctionBody": "\nfloat3 q = Pos * 11.0;\nfloat3 cell = floor(q), f = frac(q);\nfloat3 u = f * f * (3.0 - 2.0 * f);\nfloat n000 = frac(sin(dot(cell, float3(127.1,311.7,74.7))) * 43758.5453);\nfloat n100 = frac(sin(dot(cell+float3(1,0,0), float3(127.1,311.7,74.7))) * 43758.5453);\nfloat n010 = frac(sin(dot(cell+float3(0,1,0), float3(127.1,311.7,74.7))) * 43758.5453);\nfloat n110 = frac(sin(dot(cell+float3(1,1,0), float3(127.1,311.7,74.7))) * 43758.5453);\nfloat n001 = frac(sin(dot(cell+float3(0,0,1), float3(127.1,311.7,74.7))) * 43758.5453);\nfloat n101 = frac(sin(dot(cell+float3(1,0,1), float3(127.1,311.7,74.7))) * 43758.5453);\nfloat n011 = frac(sin(dot(cell+float3(0,1,1), float3(127.1,311.7,74.7))) * 43758.5453);\nfloat n111 = frac(sin(dot(cell+float3(1,1,1), float3(127.1,311.7,74.7))) * 43758.5453);\nfloat grain = lerp(lerp(lerp(n000,n100,u.x),lerp(n010,n110,u.x),u.y),lerp(lerp(n001,n101,u.x),lerp(n011,n111,u.x),u.y),u.z);\nfloat edge = saturate(EdgeMix);\nColor = lerp(Base * (0.56 + 0.44 * grain), Edge, edge * (0.35 + 0.65 * grain));\nEmission = Edge * Glow * (0.006 + edge * 0.35) * (0.84 + 0.16 * grain) * (0.94 + 0.06 * sin(Phase * 7.0));\n"
}


        {
            "m_Id": "41ea02c8d85941e0bc1f327c3df5c8e3"
        },
        {
            "m_Id": "6c82644fb4df444094ea5ca60dd54611"
        },
        {
            "m_Id": "475601a39c85452aafc883b032d897ac"
        },
        {
            "m_Id": "45203b5b87c848acb66eca7c6fc117d5"
        }
    ],
    "synonyms": [
        "code",
        "HLSL"
    ],
    "m_Precision": 0,
    "m_PreviewExpanded": false,
    "m_DismissedVersion": 0,
    "m_PreviewMode": 0,
    "m_CustomColors": {
        "m_SerializableColors": []
    },
    "m_SourceType": 1,
    "m_FunctionName": "BubbleInflate",
    "m_FunctionSource": "",
    "m_FunctionBody": "\nfloat wob = 1.0 + Wobble * sin(Phase * 6.2831853 + dot(PosOS, float3(7.1, 5.3, 3.7)));\nPosOut = PosOS + NormalOS * (Inflate * wob);\n"
}


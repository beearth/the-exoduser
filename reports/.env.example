# 도진 퀀트 킷 — 환경변수 템플릿
# 이 파일을 .env 로 복사한 뒤 값 채우면 dojin_quant.py 가 자동 로드.
# 없으면 해당 모듈만 스킵(설계대로). 값은 실측 소스 활성화용 — 지어내기 금지.

# --- 국장 실측 데이터 (개미지수 indiv, 국장 공매도) ---
# data.krx.co.kr 무료 회원가입
KRX_ID=
KRX_PW=

# --- 국장 공시 감시 (OpenDART) ---
# opendart.fss.or.kr 즉시 무료 발급
DART_API_KEY=

# --- 알림 채널 (하나만 채우면 됨) ---
# 텔레그램: @BotFather 봇생성→토큰, 봇에 메시지1개 후 api.telegram.org/bot<토큰>/getUpdates 에서 chat_id
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# 또는 디스코드 채널 설정→연동→웹훅 URL
DISCORD_WEBHOOK_URL=

# --- 개미지수 산식 (기본 vol; value=거래대금[랠리서 고착], indiv=개인실측 역산) ---
ANT_METRIC=vol

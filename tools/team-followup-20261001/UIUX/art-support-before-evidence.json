    "letterboxSource": "  const _maxAR=16/9;\n  const _curAR=_fullW/_fullH;\n  let _lbX=0,_lbY=0,cw=_fullW,ch=_fullH;\n  if(_curAR>_maxAR){cw=~~(_fullH*_maxAR);_lbX=~~((_fullW-cw)/2)}\n  else if(_curAR<9/16){ch=~~(_fullW/(9/16));_lbY=~~((_fullH-ch)/2)}\n\n",
    "clipSource": "cx.save();cx.beginPath();cx.rect(_lbX,_lbY,cw,ch);cx.clip();cx.translate(_lbX,_lbY);",
    "drawSource": "      // 카메라 트랜스폼\n      const cam=ln.cam||{zs:1,ze:1};\n      const t=Math.min(1,lineElapsed/(ln.dur||1));\n      const ef=_ease[cam.ease||'linear']||_ease.linear;\n      const et=ef(t);\n      const zoom=cam.zs+(cam.ze-cam.zs)*et;\n      const panX=(cam.px||0)*et;\n      const panY=(cam.py||0)*et;\n      // shake\n      const vfx=ln.vfx||{};\n      const sk=_cutShake(vfx.shake||0,now);\n      cx.translate(cw/2+panX+sk.x,ch/2+panY+sk.y);\n      cx.scale(zoom,zoom);\n      cx.translate(-cw/2,-ch/2);\n      // cover 방식 draw\n      const imgR=img.naturalWidth/img.naturalHeight;\n      const cR=cw/ch;\n      let dw,dh,dx,dy;\n      if(imgR>cR){dh=ch;dw=ch*imgR;dx=(cw-dw)/2;dy=0}\n      else{dw=cw;dh=cw/imgR;dx=0;dy=(ch-dh)*.1}\n      cx.drawImage(img,dx,dy,dw,dh);\n",

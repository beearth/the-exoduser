        "SHA256": "cee18604ef56d6c1c8c6c7fe7bc320f8ffede78dc2296793174699423a4ae1bc",
        "text": "function _closeCreationOverlays(){\n  _closeVisualSelect();\n  const modal=$('createModal'),keyboard=$('vkbWrap');\n  if((modal&&modal.classList.contains('show'))||$('createBtn')?.disabled)setStatus('');\n  if(modal&&modal.classList.contains('show')){\n    if(modal.contains(document.activeElement))document.activeElement.blur();\n    modal.classList.remove('show');_vkbHide();\n  }else if(keyboard&&keyboard.style.display==='block')_vkbHide();\n  if(typeof ExoduserCharacterStory!=='undefined'&&ExoduserCharacterStory.active)ExoduserCharacterStory.skip();\n}",

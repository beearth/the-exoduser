    },
    {
      "id": 8,
      "img": "06.png",
      "ko": "그 아이의 목마를 보니 망자도 정신이 드는가 보구나.",
      "en": "So the sight of that child's rocking horse brings even a dead man to his senses.",
      "speaker": "GODDESS",
      "dur": 6.033333333333333,
      "at": 25.4,
      "cam": {
        "zs": 1,
        "ze": 1.1,
        "ease": "out"
      },
      "fade": {
        "type": "cross",
        "in": 400
      }
    },
    {
      "id": 9,
      "img": "07.png",
      "ko": "",
      "en": "",
      "speaker": null,
      "dur": 2.5,
      "at": 31.433333333333334,
      "cam": {

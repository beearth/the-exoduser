{
  "status": "source_reference_only",
  "source": "game.html PROLOGUE_LINES",
  "original_duration_s": 104.5,
  "voice_id": "WS6naCm8T4gbyzsLnOjK",
  "lines": [
    {
      "id": "wa02",
      "original_start_s": 2.5,
      "original_duration_s": 2.5,
      "image": "warintro/cin_war.jpg",
      "ko": "전쟁에서 살아 돌아온 한 남자.",
      "en": "A man who returned alive from war."
    },
    {
      "id": "wa04",
      "original_start_s": 5.5,
      "original_duration_s": 5,
      "image": "warintro/cin_ruins.jpg",
      "ko": "하지만 집은 모두 불타 사라졌다.",
      "en": "But his home had burned to nothing."
    },
    {
      "id": "wa06",
      "original_start_s": 13,
      "original_duration_s": 4.5,
      "image": "warintro/cin_throne.jpg",
      "ko": "이웃이자 친구였던 킬루가 그의 가문을 짓밟았다.",
      "en": "Killu, once a neighbor and friend, had crushed his family."
    },
    {
      "id": "wa08",
      "original_start_s": 19.7,
      "original_duration_s": 4.2,
      "image": "warintro/cin_throne.jpg",
      "ko": "아내는 몸종으로 끌려가 온갖 몹쓸 짓을 당했고,",
      "en": "His wife was taken as a servant and suffered unspeakable horrors,"
    },
    {
      "id": "wa09",
      "original_start_s": 23.9,
      "original_duration_s": 3.1,
      "image": "warintro/cin_throne.jpg",
      "ko": "끝내 못 이겨 스스로 목숨을 끊었다.",
      "en": "until she could bear no more and took her own life."
    },
    {
      "id": "wa11",
      "original_start_s": 28.6,
      "original_duration_s": 4.4,
      "image": "warintro/cin_throne.jpg",
      "ko": "아이들은 노예로 팔려가 어디에 있는지조차 알 수 없다.",
      "en": "His children were sold into slavery — their fate unknown."
    },
    {
      "id": "wa12",
      "original_start_s": 33,
      "original_duration_s": 4,
      "image": "warintro/cin_throne.jpg",
      "ko": "늙은 부모는 감옥에 갇혀 굶어 죽었다.",
      "en": "His elderly parents were imprisoned and starved to death."
    },
    {
      "id": "wa14",
      "original_start_s": 38.8,
      "original_duration_s": 4.5,
      "image": "warintro/cin_bystanders.jpg",
      "ko": "킬루 가문의 모두가 알고 있었다.",
      "en": "Everyone in the Killu household knew."
    },
    {
      "id": "wa15",
      "original_start_s": 43.3,
      "original_duration_s": 2.7,
      "image": "warintro/cin_bystanders.jpg",
      "ko": "31명이 보고도 못 본 척했다.",
      "en": "Thirty-one of them saw everything and looked away."
    },
    {
      "id": "wa17",
      "original_start_s": 47.9,
      "original_duration_s": 3.1,
      "image": "warintro/cin_bloodbath.jpg",
      "ko": "그날 밤, 킬루 가문을 모두 죽였다.",
      "en": "That night, he killed every last one of them."
    },
    {
      "id": "wa19",
      "original_start_s": 53.6,
      "original_duration_s": 3,
      "image": "warintro/cin_torture.jpg",
      "ko": "칼로 킬루의 팔다리를 자르고",
      "en": "He cut off Killu's limbs with a blade,"
    },
    {
      "id": "wa20",
      "original_start_s": 56.6,
      "original_duration_s": 2.6,
      "image": "warintro/cin_torture.jpg",
      "ko": "불로 지혈까지 해주며",
      "en": "cauterized the wounds with fire,"
    },
    {
      "id": "wa21",
      "original_start_s": 59.2,
      "original_duration_s": 6,
      "image": "warintro/cin_torture.jpg",
      "ko": "오래오래 살려두었다.",
      "en": "and kept him alive for a long, long time."
    },
    {
      "id": "wa22",
      "original_start_s": 65.2,
      "original_duration_s": 3,
      "image": "warintro/cin_remember.jpg",
      "ko": "\"기억하라.\"",
      "en": "\"Remember.\""
    },
    {
      "id": "wa23",
      "original_start_s": 68.2,
      "original_duration_s": 5.4,
      "image": "warintro/cin_remember.jpg",
      "ko": "\"그리고 지옥에서도 후회하라.\"",
      "en": "\"And regret it even in hell.\""
    },
    {
      "id": "wa24",
      "original_start_s": 73.6,
      "original_duration_s": 2.4,
      "image": "warintro/cin_fallhell_custom.jpg",
      "ko": "그리고 지옥에 떨어진다.",
      "en": "And so he fell into hell."
    },
    {
      "id": "wa26",
      "original_start_s": 78.9,
      "original_duration_s": 3.6,
      "image": "warintro/emg1.jpg",
      "ko": "\"...이것은 셀 수 없는 복수자 중 하나의 이야기일 뿐.\"",
      "en": "\"...This is but one tale among countless avengers.\""
    },
    {
      "id": "wa28",
      "original_start_s": 84.8,
      "original_duration_s": 4.1,
      "image": "warintro/cin_demonbattle.jpg",
      "ko": "\"지옥의 미로에는 매일 새로운 영혼이 떨어진다.\"",
      "en": "\"Every day, new souls fall into hell's labyrinth.\""
    },
    {
      "id": "wa29",
      "original_start_s": 88.9,
      "original_duration_s": 5.1,
      "image": "warintro/cin_demonfight.jpg",
      "ko": "\"분노로 가득 찬 자, 억울함에 미친 자, 사랑을 잃은 자...\"",
      "en": "\"Those consumed by rage, driven mad by injustice, those who lost love...\""
    },
    {
      "id": "wa31",
      "original_start_s": 94.8,
      "original_duration_s": 2.2,
      "image": "warintro/cin_nemesia_hd.jpg",
      "ko": "\"너는 왜 지옥에 왔느냐?\"",
      "en": "\"Why have you come to hell?\""
    },
    {
      "id": "wa33",
      "original_start_s": 99,
      "original_duration_s": 4,
      "image": "warintro/cin_nemesia_hd.jpg",
      "ko": "\"지옥을 탈출하라, 죄인이여.\"",
      "en": "\"Escape from hell, sinner.\""
    }
  ],

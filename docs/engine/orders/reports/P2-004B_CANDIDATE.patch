+func _pet_bag_next(bag: Array, length: int) -> int:
+	if bag.is_empty():
+		for i in range(length):
+			bag.append(i)
+		for i in range(length - 1, 0, -1):
+			var j: int = mini(i, floori(_dialogue_rng.randf() * (i + 1)))
+			var value: int = int(bag[i])
+			bag[i] = bag[j]
+			bag[j] = value
+	return int(bag.pop_back())
+

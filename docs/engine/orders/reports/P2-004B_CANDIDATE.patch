+	if _pet_combo_kills == 100:
+		_offer_dialogue("combo_100")
+	if float(p.get("hp", 0.0)) > 0.0 and float(p["hp"]) < float(p["mhp"]) * 0.1:
+		_offer_dialogue("low_hp_kill")
+	# multi_kill: 원본9781 정의만 있고 호출처 없음. 임의 호출을 추가하지 않는다.

-func _move_pet(pet: Dictionary, spd: float) -> void:
-	var dx: float = pet["tx"] - pet["x"]
-	var dy: float = pet["ty"] - pet["y"]
-	var d: float = sqrt(dx * dx + dy * dy)
-	pet["pdx"] = dx
-	pet["pdy"] = dy
-	pet["moving"] = d > 5.0
-	if d > 3.0:
-		var s: float = minf(spd, d * 0.12)
-		pet["x"] += dx / d * s
-		pet["y"] += dy / d * s
-	else:
-		pet["x"] = pet["tx"]
-		pet["y"] = pet["ty"]
-

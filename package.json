{
  "name": "hell-exoduser-release",
  "private": true,
  "version": "0.7.2",
  "type": "module",
  "main": "http://localhost:3350/index.html",
  "node-main": "node-main.js",
  "exoduser": {"target":"full","appId":4749590,"depotId":4749591,"port":3350,"saveNamespace":"EXODUSER-HELL-FULL"},
  "node-remote": [
    "http://127.0.0.1:3350",
    "http://localhost:3350"
  ],
  "window": {
    "title": "EXODUSER: HELL LORD",
    "width": 1920,
    "height": 1080,
    "min_width": 1280,
    "min_height": 720,
    "fullscreen": true,
    "resizable": true,
    "frame": false,
    "toolbar": false
  },
  "chromium-args": "--disable-features=CrossOriginOpenerPolicy,CrossOriginEmbedderPolicy,IsolateOrigins,SitePerProcess,SkiaGraphite --disable-site-isolation-trials --disable-web-security --no-sandbox --ignore-gpu-blocklist --enable-gpu-rasterization --allow-running-insecure-content --autoplay-policy=no-user-gesture-required --enable-features=SharedArrayBuffer --user-data-dir=./userdata-full",
  "scripts": {
    "start": "node server.cjs",
    "check": "node tools/project-check.mjs",
    "engine:check": "node --test test/fdgProject.test.mjs test/fdgRuntime.test.mjs test/fdgLegacy.test.mjs test/fdgCharacterQuality.test.mjs test/fdgCharacterDrafts.test.mjs test/fdgProfiler.test.mjs test/fdgOptimization.test.mjs",
    "engine:qa": "node tools/fdg-studio-smoke.mjs",
    "engine:rig:check": "node --test test/fdgRigProject.test.mjs test/fdgRigRuntime.test.mjs",
    "engine:rig:qa": "node tools/fdg-rig-smoke.mjs",
    "engine:rig-scene:check": "node --test test/fdgRigSceneProject.test.mjs test/fdgRigSceneRuntime.test.mjs",
    "engine:rig-scene:qa": "node tools/fdg-rig-scene-smoke.mjs",
    "engine:catalog": "node tools/fdg-catalog.mjs",
    "engine:characters": "node tools/fdg-character-build.mjs",
    "build:web": "node tools/build-web.mjs",
    "serve:map": "\"C:\\nvm4w\\nodejs\\node.exe\" tools/map-test-server.mjs",
    "serve:test": "node tools/local-static-server.mjs",
    "pixellab:request": "node tools/pixellab_request.mjs",
    "pixellab:silvertail:sync": "node tools/sync_silvertail_pixellab.mjs",
    "pixellab:ch1:8dir": "node tools/complete_ch1_8dir.mjs",
    "pixellab:ch1:atlas-sync": "node tools/sync_ch1_monster_atlas_sources.mjs",
    "elevenlabs:tts": "node tools/elevenlabs_tts.mjs",
    "docs:check": "node tools/docs-sync-check.mjs",
    "docs:check:staged": "node tools/docs-sync-check.mjs --staged",
    "hooks:install": "git config core.hooksPath .githooks",
    "auto:sync": "powershell -ExecutionPolicy Bypass -File auto_commit.ps1",
    "auto:task:install": "powershell -ExecutionPolicy Bypass -File tools/install-auto-sync-task.ps1",
    "build:nwjs": "node build-nwjs.mjs"
  },
  "devDependencies": {
    "sharp": "^0.34.5"
  },
  "dependencies": {
    "acorn": "^8.16.0",
    "canvas": "^3.2.3",
    "nw-builder": "^4.17.10",
    "omggif": "^1.0.10",
    "playwright": "^1.58.2",
    "pngjs": "^7.0.0"
  }
}

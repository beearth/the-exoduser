[
  {
    "id": "wa02",
    "start": 1,
    "end": 3.21,
    "text": "一個從戰爭中生還的男人。"
  },
  {
    "id": "wa04",
    "start": 5.5,
    "end": 7.51,
    "text": "然而，他的家早已被烈火吞噬。"
  },
  {
    "id": "wa06",
    "start": 10,
    "end": 14.030000000000001,
    "text": "曾是鄰居與朋友的基路，踐踏了他的家族。"
  },
  {
    "id": "wa08",
    "start": 16,
    "end": 20.43,
    "text": "妻子被擄去當侍女，受盡凌辱，"
  },
  {
    "id": "wa09",
    "start": 22.5,
    "end": 25.33,
    "text": "最終不堪折磨，結束了自己的生命。"
  },
  {
    "id": "wa11",
    "start": 28,
    "end": 32.05,
    "text": "孩子們被賣為奴隸，至今下落不明。"
  },
  {
    "id": "wa12",
    "start": 33.5,
    "end": 36.85,
    "text": "年邁的父母被關進牢獄，活活餓死。"
  },
  {
    "id": "wa14",
    "start": 39,
    "end": 41.51,
    "text": "基路家族的每個人都知道。"
  },
  {
    "id": "wa15",
    "start": 42.24,
    "end": 45.15,
    "text": "31人親眼目睹，卻佯裝不見。"
  },
  {
    "id": "wa17",
    "start": 46.5,
    "end": 49.05,
    "text": "那一夜，他殺光了基路全族。"
  },
  {
    "id": "wa19",
    "start": 51,
    "end": 53.41,
    "text": "他用刀斬斷基路的四肢，"
  },
  {
    "id": "wa20",
    "start": 53.48,
    "end": 55.69,
    "text": "甚至用火替他止血，"
  },
  {
    "id": "wa21",
    "start": 56.019999999999996,
    "end": 59.03,
    "text": "讓他久久不能死去。"
  },
  {
    "id": "wa22",
    "start": 59.5,
    "end": 59.98,
    "text": "「記住。」"
  },
  {
    "id": "wa23",
    "start": 59.98,
    "end": 62.43,
    "text": "「到了地獄，也給我後悔吧。」"
  },
  {
    "id": "wa24",
    "start": 65,
    "end": 66.51,
    "text": "而後，他墜入地獄。"
  },
  {
    "id": "wa26",
    "start": 70.67,
    "end": 73.86,
    "text": "「……這不過是無數復仇者中的一個故事。」"
  },
  {
    "id": "wa28",
    "start": 76,
    "end": 79.45,
    "text": "「每天都有新的靈魂墜入地獄迷宮。」"
  },
  {
    "id": "wa29",
    "start": 81.5,
    "end": 87.41,
    "text": "「滿懷憤怒的人、因冤屈而瘋狂的人、失去摯愛的人……」"
  },
  {
    "id": "wa31",
    "start": 88,
    "end": 90.33333333333333,
    "text": "「你又為何來到地獄？」"
  },
  {
    "id": "wa33a",
    "start": 90.33333333333333,
    "end": 91.395,
    "text": "「逃離地獄。」"
  },
  {
    "id": "wa33b",
    "start": 92.9,
    "end": 95.6,
    "text": "「你……背負罪孽之人。」"
  }
]

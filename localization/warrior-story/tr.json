[
  {
    "id": "wa02",
    "start": 1,
    "end": 3.21,
    "text": "Bir adam savaştan sağ döndü."
  },
  {
    "id": "wa04",
    "start": 5.5,
    "end": 7.51,
    "text": "Ama evi yanıp kül olmuştu."
  },
  {
    "id": "wa06",
    "start": 10,
    "end": 14.030000000000001,
    "text": "Komşusu ve dostu Killu, ailesini ezip geçmişti."
  },
  {
    "id": "wa08",
    "start": 16,
    "end": 20.43,
    "text": "Karısı hizmetçi olarak götürülmüş, türlü eziyetlere uğramıştı;"
  },
  {
    "id": "wa09",
    "start": 22.5,
    "end": 25.33,
    "text": "sonunda dayanamayarak canına kıymıştı."
  },
  {
    "id": "wa11",
    "start": 28,
    "end": 32.05,
    "text": "Çocukları köle diye satılmıştı. Nerede oldukları bile bilinmiyordu."
  },
  {
    "id": "wa12",
    "start": 33.5,
    "end": 36.85,
    "text": "Yaşlı anne babası zindanda açlıktan ölmüştü."
  },
  {
    "id": "wa14",
    "start": 39,
    "end": 41.51,
    "text": "Killu hanesindeki herkes biliyordu."
  },
  {
    "id": "wa15",
    "start": 42.24,
    "end": 45.15,
    "text": "31 kişi görmüş, görmemiş gibi yapmıştı."
  },
  {
    "id": "wa17",
    "start": 46.5,
    "end": 49.05,
    "text": "O gece Killu'nun tüm ailesini öldürdü."
  },
  {
    "id": "wa19",
    "start": 51,
    "end": 53.41,
    "text": "Kılıcıyla Killu'nun kollarını ve bacaklarını kesti,"
  },
  {
    "id": "wa20",
    "start": 53.48,
    "end": 55.69,
    "text": "hatta kanamayı durdurmak için yaralarını ateşle dağladı,"
  },
  {
    "id": "wa21",
    "start": 56.019999999999996,
    "end": 59.03,
    "text": "onu çok, çok uzun süre hayatta tuttu."
  },
  {
    "id": "wa22",
    "start": 59.5,
    "end": 59.98,
    "text": "“Unutma.”"
  },
  {
    "id": "wa23",
    "start": 59.98,
    "end": 62.43,
    "text": "“Ve cehennemde bile pişman ol.”"
  },
  {
    "id": "wa24",
    "start": 65,
    "end": 66.51,
    "text": "Sonra cehenneme düştü."
  },
  {
    "id": "wa26",
    "start": 70.67,
    "end": 73.86,
    "text": "“…Bu, sayısız intikamcıdan yalnızca birinin hikâyesi.”"
  },
  {
    "id": "wa28",
    "start": 76,
    "end": 79.45,
    "text": "“Cehennemin labirentine her gün yeni ruhlar düşer.”"
  },
  {
    "id": "wa29",
    "start": 81.5,
    "end": 87.41,
    "text": "“Öfkeyle dolanlar, haksızlıktan delirenler, sevdiklerini kaybedenler…”"
  },
  {
    "id": "wa31",
    "start": 88,
    "end": 90.33333333333333,
    "text": "“Sen neden cehenneme geldin?”"
  },
  {
    "id": "wa33a",
    "start": 90.33333333333333,
    "end": 91.395,
    "text": "“Cehennemden kaç.”"
  },
  {
    "id": "wa33b",
    "start": 92.9,
    "end": 95.6,
    "text": "“Sen… günahın yükünü taşıyan kişi.”"
  }
]

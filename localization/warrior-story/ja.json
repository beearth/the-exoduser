[
  {
    "id": "wa02",
    "start": 1,
    "end": 3.21,
    "text": "戦争から生きて帰った一人の男。"
  },
  {
    "id": "wa04",
    "start": 5.5,
    "end": 7.51,
    "text": "だが家はすべて焼け落ちていた。"
  },
  {
    "id": "wa06",
    "start": 10,
    "end": 14.030000000000001,
    "text": "隣人であり友人だったキルルが、彼の一族を踏みにじった。"
  },
  {
    "id": "wa08",
    "start": 16,
    "end": 20.43,
    "text": "妻は召使いとして連れ去られ、数々の非道な仕打ちを受け、"
  },
  {
    "id": "wa09",
    "start": 22.5,
    "end": 25.33,
    "text": "ついに耐えきれず自ら命を絶った。"
  },
  {
    "id": "wa11",
    "start": 28,
    "end": 32.05,
    "text": "子供たちは奴隷として売られ、行方すら分からない。"
  },
  {
    "id": "wa12",
    "start": 33.5,
    "end": 36.85,
    "text": "老いた両親は牢に閉じ込められ、餓死した。"
  },
  {
    "id": "wa14",
    "start": 39,
    "end": 41.51,
    "text": "キルル家の誰もが知っていた。"
  },
  {
    "id": "wa15",
    "start": 42.24,
    "end": 45.15,
    "text": "三十一人が見て見ぬふりをした。"
  },
  {
    "id": "wa17",
    "start": 46.5,
    "end": 49.05,
    "text": "その夜、キルル家の全員を殺した。"
  },
  {
    "id": "wa19",
    "start": 51,
    "end": 53.41,
    "text": "刃でキルルの手足を切り落とし、"
  },
  {
    "id": "wa20",
    "start": 53.48,
    "end": 55.69,
    "text": "火で傷口を焼いて血まで止めてやり、"
  },
  {
    "id": "wa21",
    "start": 56.019999999999996,
    "end": 59.03,
    "text": "長い長い間、生かし続けた。"
  },
  {
    "id": "wa22",
    "start": 59.5,
    "end": 59.98,
    "text": "「覚えておけ。」"
  },
  {
    "id": "wa23",
    "start": 59.98,
    "end": 62.43,
    "text": "「そして地獄でも悔やめ。」"
  },
  {
    "id": "wa24",
    "start": 65,
    "end": 66.51,
    "text": "そして地獄に落ちた。"
  },
  {
    "id": "wa26",
    "start": 70.67,
    "end": 73.86,
    "text": "「……これは数えきれない復讐者の中の、一つの物語に過ぎない。」"
  },
  {
    "id": "wa28",
    "start": 76,
    "end": 79.45,
    "text": "「地獄の迷宮には毎日新たな魂が落ちてくる。」"
  },
  {
    "id": "wa29",
    "start": 81.5,
    "end": 87.41,
    "text": "「怒りに満ちた者、理不尽に狂った者、愛を失った者……」"
  },
  {
    "id": "wa31",
    "start": 88,
    "end": 90.33333333333333,
    "text": "「お前はなぜ地獄に来た？」"
  },
  {
    "id": "wa33a",
    "start": 90.33333333333333,
    "end": 91.395,
    "text": "「地獄から脱出せよ。」"
  },
  {
    "id": "wa33b",
    "start": 92.9,
    "end": 95.6,
    "text": "「罪の重荷を背負いし者よ。」"
  }
]

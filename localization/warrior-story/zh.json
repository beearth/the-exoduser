[
  {
    "id": "wa02",
    "start": 1,
    "end": 3.21,
    "text": "一个从战争中活着回来的男人。"
  },
  {
    "id": "wa04",
    "start": 5.5,
    "end": 7.51,
    "text": "但家园已化为灰烬。"
  },
  {
    "id": "wa06",
    "start": 10,
    "end": 14.030000000000001,
    "text": "曾是邻居和朋友的基路，摧毁了他的家族。"
  },
  {
    "id": "wa08",
    "start": 16,
    "end": 20.43,
    "text": "妻子被掳为奴仆，受尽种种凌辱，"
  },
  {
    "id": "wa09",
    "start": 22.5,
    "end": 25.33,
    "text": "最终不堪忍受，结束了自己的生命。"
  },
  {
    "id": "wa11",
    "start": 28,
    "end": 32.05,
    "text": "孩子们被卖为奴隶，下落不明。"
  },
  {
    "id": "wa12",
    "start": 33.5,
    "end": 36.85,
    "text": "年迈的父母被关进牢狱，活活饿死。"
  },
  {
    "id": "wa14",
    "start": 39,
    "end": 41.51,
    "text": "基路家族的所有人都知道。"
  },
  {
    "id": "wa15",
    "start": 42.24,
    "end": 45.15,
    "text": "三十一人目睹一切，却视而不见。"
  },
  {
    "id": "wa17",
    "start": 46.5,
    "end": 49.05,
    "text": "那天夜里，他杀光了基路全族。"
  },
  {
    "id": "wa19",
    "start": 51,
    "end": 53.41,
    "text": "用刀砍断了基路的四肢，"
  },
  {
    "id": "wa20",
    "start": 53.48,
    "end": 55.69,
    "text": "甚至用火替他止血，"
  },
  {
    "id": "wa21",
    "start": 56.019999999999996,
    "end": 59.03,
    "text": "让他活了很久很久。"
  },
  {
    "id": "wa22",
    "start": 59.5,
    "end": 59.98,
    "text": "“记住。”"
  },
  {
    "id": "wa23",
    "start": 59.98,
    "end": 62.43,
    "text": "“在地狱里也要后悔。”"
  },
  {
    "id": "wa24",
    "start": 65,
    "end": 66.51,
    "text": "然后，他坠入了地狱。"
  },
  {
    "id": "wa26",
    "start": 70.67,
    "end": 73.86,
    "text": "“……这不过是无数复仇者中一人的故事。”"
  },
  {
    "id": "wa28",
    "start": 76,
    "end": 79.45,
    "text": "“每天都有新的灵魂坠入地狱的迷宫。”"
  },
  {
    "id": "wa29",
    "start": 81.5,
    "end": 87.41,
    "text": "“满怀愤怒的人、因冤屈而疯狂的人、失去挚爱的人……”"
  },
  {
    "id": "wa31",
    "start": 88,
    "end": 90.33333333333333,
    "text": "“你为什么来到地狱？”"
  },
  {
    "id": "wa33a",
    "start": 90.33333333333333,
    "end": 91.395,
    "text": "“逃离地狱。”"
  },
  {
    "id": "wa33b",
    "start": 92.9,
    "end": 95.6,
    "text": "“你……背负罪孽之人。”"
  }
]
